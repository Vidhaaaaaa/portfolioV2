---
import Layout from '../layouts/Layout.astro';
import GithubGraph from "../components/githubGraph.astro";

import { getGithubContributions } from "../lib/github";

const githubData = await getGithubContributions();
---

<Layout title="vidha">
	<!-- Navigation -->
	<nav class="nav">
		<div class="nav-left">
			<a href="https://github.com/vidha" target="_blank" rel="noopener">github</a>
			<span class="nav-separator">·</span>
			<a href="https://x.com/vidha" target="_blank" rel="noopener">x</a>
			<span class="nav-separator">·</span>
			<a href="https://linkedin.com/in/vidha" target="_blank" rel="noopener">linkedin</a>
			<span class="nav-separator">·</span>
			<a href="mailto:hello@vidha.com">email</a>
		</div>
		<div class="nav-right">
			<a href="#contact">work with me →</a>
			<span class="nav-separator">·</span>
			<a href="mailto:hello@vidha.com">just say hi →</a>
		</div>
	</nav>

	<!-- Birthday Counter -->
	<div class="birthday-counter">
		<span id="days-count">[dynamic]</span> till i turn 21
	</div>

	<div class="container">
		<!-- Hero -->
		<section class="hero">

			<GithubGraph data={githubData} />
			
			<div class="hero-header">
				<img src="../src/images/pfp.jpeg" alt="vidha" class="profile-pic" />
				<h1>hi, i'm vidha, 20.</h1>
			</div>

			<p class="handwritten hero-intro">i build and ship things on the internet.</p>
			<p class="handwritten hero-intro">usually something i probably didn't need to build.</p>

			<p class="hero-role">full-stack developer · founder · product builder</p>

			<!-- Skills -->
			<div class="skills">
				<span class="skill-icon" title="Python">🐍</span>
				<span class="skill-icon" title="FastAPI">⚡</span>
				<span class="skill-icon" title="PostgreSQL">🐘</span>
				<span class="skill-icon" title="Git">📦</span>
				<span class="skill-icon" title="Docker">🐳</span>
				<span class="skill-icon" title="React">⚛️</span>
				<span class="skill-icon" title="C">©️</span>
				<span class="skill-icon" title="Java">☕</span>
			</div>

			<!-- Tiny Live Details -->
			<div class="live-details">
				<div class="live-item">
					<span class="live-icon">♫</span>
					<span class="live-text">currently listening — <a href="#">song · artist</a></span>
				</div>
				<div class="live-item">
					<span class="live-icon">𝕏</span>
					<span class="live-text">latest — <a href="#" target="_blank" rel="noopener">short preview</a></span>
				</div>
			</div>

			<!-- Contexta -->
			<div class="contexta-card">
				<p class="contexta-label">currently building</p>
				<h3 class="contexta-name">contexta</h3>
				<p class="contexta-role">founder & ceo · 2026</p>
				<p class="contexta-desc">a memory layer for codebases.</p>
			</div>
		</section>

		<!-- Projects -->
		<section class="projects">
			<h2>things i've built</h2>
			
			<div class="project-grid">
				<div class="project-card">
					<div class="project-image">
						<img src="/images/contexta-preview.jpg" alt="contexta" />
					</div>
					<h3>contexta</h3>
					<p class="project-desc">a conceptual memory layer for codebases</p>
					<div class="project-stack">
						<span class="stack-item">python</span>
						<span class="stack-item">fastapi</span>
						<span class="stack-item">postgresql</span>
					</div>
					<div class="project-links">
						<a href="#" class="project-link">live</a>
						<a href="https://github.com/vidha/contexta" target="_blank" rel="noopener" class="project-link">github</a>
					</div>
				</div>

				<div class="project-card">
					<div class="project-image">
						<img src="/images/skippit-preview.jpg" alt="skippit" />
					</div>
					<h3>skippit</h3>
					<p class="project-desc">async interviews for startups</p>
					<div class="project-stack">
						<span class="stack-item">python</span>
						<span class="stack-item">flask</span>
						<span class="stack-item">webrtc</span>
					</div>
					<div class="project-links">
						<a href="#" class="project-link">live</a>
						<a href="https://github.com/vidha/skippit" target="_blank" rel="noopener" class="project-link">github</a>
					</div>
				</div>

				<div class="project-card">
					<div class="project-image">
						<img src="/images/ditto-preview.jpg" alt="ditto" />
					</div>
					<h3>ditto</h3>
					<p class="project-desc">screenshots → useful information</p>
					<div class="project-stack">
						<span class="stack-item">python</span>
						<span class="stack-item">fastapi</span>
						<span class="stack-item">tesseract</span>
					</div>
					<div class="project-links">
						<a href="#" class="project-link">live</a>
						<a href="https://github.com/vidha/ditto" target="_blank" rel="noopener" class="project-link">github</a>
					</div>
				</div>

				<div class="project-card">
					<div class="project-image">
						<img src="/images/snaptunnel-preview.jpg" alt="snaptunnel" />
					</div>
					<h3>snaptunnel</h3>
					<p class="project-desc">peer-to-peer file sharing</p>
					<div class="project-stack">
						<span class="stack-item">javascript</span>
						<span class="stack-item">webtorrent</span>
						<span class="stack-item">webrtc</span>
					</div>
					<div class="project-links">
						<a href="#" class="project-link">live</a>
						<a href="https://github.com/vidha/snaptunnel" target="_blank" rel="noopener" class="project-link">github</a>
					</div>
				</div>

				<div class="project-card">
					<div class="project-image">
						<img src="/images/ticketledger-preview.jpg" alt="ticketledger" />
					</div>
					<h3>ticketledger</h3>
					<p class="project-desc">decentralized ticketing on aptos</p>
					<div class="project-stack">
						<span class="stack-item">move</span>
						<span class="stack-item">aptos</span>
						<span class="stack-item">typescript</span>
					</div>
					<div class="project-links">
						<a href="#" class="project-link">live</a>
						<a href="https://github.com/vidha/ticketledger" target="_blank" rel="noopener" class="project-link">github</a>
					</div>
				</div>

				<div class="project-card">
					<div class="project-image">
						<img src="/images/accelerate-preview.jpg" alt="accelerate" />
					</div>
					<h3>accelerate</h3>
					<p class="project-desc">builder community</p>
					<div class="project-stack">
						<span class="stack-item">community</span>
						<span class="stack-item">open source</span>
					</div>
					<div class="project-links">
						<a href="#" class="project-link">learn more</a>
					</div>
				</div>
			</div>

			<a href="/work" class="see-more">see everything i've built →</a>
		</section>

		<!-- Experience -->
		<section class="experience">
			<h2>experience</h2>
			
			<div class="experience-list">
				<div class="experience-item">
					<h3>contexta</h3>
					<p class="experience-role">founder & ceo · may 2026–present</p>
				</div>

				<div class="experience-item">
					<h3>[company name]</h3>
					<p class="experience-role">[role] · [year/date]</p>
					<p class="experience-desc">1–2 lines describing what you actually worked on</p>
				</div>
			</div>

			<a href="/work" class="see-more">see full experience →</a>
		</section>

		<!-- Contact -->
		<section class="contact" id="contact">
			<h2>want to build something?</h2>
			<p class="contact-desc">i build web apps, backend systems, APIs, internal tools, MVPs and automations for startups and other people building things.</p>
			<a href="mailto:hello@vidha.com" class="cta-button">let's talk →</a>
		</section>

		<!-- Communities -->
		<section class="communities">
			<h2>communities</h2>
			
			<div class="community-list">
				<div class="community-item">
					<h3>eis</h3>
					<p class="community-role">general secretary</p>
					<p class="community-desc">building entrepreneurship and innovation at university</p>
				</div>

				<div class="community-item">
					<h3>accelerate</h3>
					<p class="community-role">founder</p>
					<p class="community-desc">builder community around open source and collaboration</p>
				</div>
			</div>
		</section>

		<!-- Personal -->
		<section class="personal">
			<h2>beyond code</h2>
			
			<div class="personal-grid">
				<div class="personal-item">
					<img src="/gifs/guitar.gif" alt="Guitar" class="personal-img" />
					<p class="personal-caption">learning guitar since december 2025</p>
				</div>
				
				<div class="personal-item">
					<img src="/images/friends.jpg" alt="Friends" class="personal-img" />
					<p class="personal-caption">friends · university · life</p>
				</div>
				
				<div class="personal-item">
					<p class="personal-text">music · video editing · reading · random experiments · cats</p>
					<p class="handwritten">and approximately 47 unfinished side projects.</p>
				</div>
			</div>
		</section>
	</div>

	<!-- Footer -->
	<footer class="footer">
		<p> 2026 vidha · <a href="https://github.com/vidha/portfolio" target="_blank" rel="noopener">this site is open source</a></p>
	</footer>
</Layout>

<style>
	/* Navigation */
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		padding: 1rem 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: var(--bg-paper);
		z-index: 100;
		font-size: 0.875rem;
	}

	.nav-left,
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-separator {
		color: var(--text-muted);
	}

	/* Birthday Counter */
	.birthday-counter {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		font-size: 0.75rem;
		color: var(--text-muted);
		background: var(--surface);
		padding: 0.5rem 1rem;
		border-radius: 20px;
		border: 1px solid var(--border-subtle);
	}

	/* Hero */
	.hero {
		padding: 6rem 0 4rem;
		position: relative;
	}

	.hero::before {
		content: '';
		position: absolute;
		top: -50%;
		right: -20%;
		width: 400px;
		height: 400px;
		background: radial-gradient(circle, var(--accent-lavender-light) 0%, transparent 70%);
		opacity: 0.15;
		border-radius: 50%;
		pointer-events: none;
	}

	.hero-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
		position: relative;
	}

	.profile-pic {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--accent-gold);
		box-shadow: 0 4px 12px rgba(201, 169, 98, 0.2);
	}

	.hero h1 {
		margin: 0;
		font-size: 2.25rem;
		background: linear-gradient(135deg, var(--text-charcoal) 0%, var(--text-charcoal-light) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-intro {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
		color: var(--text-charcoal);
		position: relative;
	}

	.hero-role {
		font-size: 1rem;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		position: relative;
	}

	/* Skills */
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.skill-icon {
		font-size: 1.5rem;
		cursor: default;
		transition: transform 0.3s ease, filter 0.3s ease;
		filter: grayscale(30%);
	}

	.skill-icon:hover {
		transform: scale(1.2) rotate(5deg);
		filter: grayscale(0%);
	}

	/* Live Details */
	.live-details {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 2rem;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.live-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.live-icon {
		font-size: 0.875rem;
	}

	.live-text a {
		color: var(--accent-lavender);
	}

	/* Contexta Card */
	.contexta-card {
		padding: 1.5rem;
		background: linear-gradient(135deg, var(--surface) 0%, var(--surface-subtle) 100%);
		border: 1px solid var(--accent-gold);
		border-radius: 12px;
		margin-bottom: 2rem;
		position: relative;
		overflow: hidden;
	}

	.contexta-card::before {
		content: '';
		position: absolute;
		top: 0;
		right: 0;
		width: 100px;
		height: 100px;
		background: radial-gradient(circle, var(--accent-gold-light) 0%, transparent 70%);
		opacity: 0.1;
		border-radius: 50%;
	}

	.contexta-label {
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-bottom: 0.25rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.contexta-name {
		font-size: 1.5rem;
		margin-bottom: 0.25rem;
		color: var(--accent-gold);
		position: relative;
	}

	.contexta-role {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.contexta-desc {
		font-size: 0.9375rem;
		margin: 0;
		position: relative;
	}

	/* Projects */
	.projects {
		padding: 3rem 0;
		position: relative;
	}

	.projects h2 {
		position: relative;
		display: inline-block;
	}

	.projects h2::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 40px;
		height: 2px;
		background: var(--accent-lavender);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.project-card {
		background: var(--surface);
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.project-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
	}

	.project-image {
		width: 100%;
		height: 140px;
		overflow: hidden;
		background: var(--bg-paper-dark);
	}

	.project-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.project-card:hover .project-image img {
		transform: scale(1.05);
	}

	.project-card h3 {
		font-size: 1.125rem;
		margin: 1rem 1rem 0.5rem;
	}

	.project-desc {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin: 0 1rem 0.75rem;
	}

	.project-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 1rem 0.75rem;
	}

	.stack-item {
		font-size: 0.75rem;
		padding: 0.25rem 0.5rem;
		background: var(--surface-subtle);
		border-radius: 4px;
		color: var(--text-muted);
	}

	.project-links {
		display: flex;
		gap: 0.75rem;
		margin: 0 1rem 1rem;
	}

	.project-link {
		font-size: 0.75rem;
		color: var(--accent-lavender);
	}

	.see-more {
		display: inline-block;
		font-size: 0.875rem;
		color: var(--accent-lavender);
	}

	/* Experience */
	.experience {
		padding: 3rem 0;
	}

	.experience-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.experience-item {
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border-light);
	}

	.experience-item:last-child {
		border-bottom: none;
	}

	.experience-item h3 {
		font-size: 1rem;
		margin-bottom: 0.25rem;
	}

	.experience-role {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin-bottom: 0.25rem;
	}

	.experience-desc {
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	/* Contact */
	.contact {
		padding: 3rem 0;
		background: linear-gradient(135deg, var(--surface-subtle) 0%, var(--bg-paper-dark) 100%);
		border-radius: 12px;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.contact::before {
		content: '';
		position: absolute;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		background: radial-gradient(circle, var(--accent-lavender-light) 0%, transparent 50%);
		opacity: 0.05;
		pointer-events: none;
	}

	.contact h2 {
		margin-bottom: 1rem;
		position: relative;
	}

	.contact-desc {
		font-size: 0.9375rem;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		max-width: 500px;
		margin-left: auto;
		margin-right: auto;
		position: relative;
	}

	.cta-button {
		display: inline-block;
		padding: 0.875rem 2rem;
		background: var(--accent-lavender);
		color: white;
		border-radius: 8px;
		font-size: 0.875rem;
		transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
		position: relative;
	}

	.cta-button:hover {
		background: var(--accent-lavender-light);
		color: var(--text-charcoal);
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(168, 152, 176, 0.3);
	}

	/* Communities */
	.communities {
		padding: 3rem 0;
	}

	.community-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.community-item {
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		transition: transform 0.3s ease, border-color 0.3s ease;
	}

	.community-item:hover {
		transform: translateX(4px);
		border-color: var(--accent-lavender);
	}

	.community-item h3 {
		font-size: 1.125rem;
		margin-bottom: 0.25rem;
	}

	.community-role {
		font-size: 0.75rem;
		color: var(--accent-lavender);
		margin-bottom: 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.community-desc {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin: 0;
	}

	/* Personal */
	.personal {
		padding: 3rem 0;
	}

	.personal h2 {
		position: relative;
		display: inline-block;
	}

	.personal h2::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 40px;
		height: 2px;
		background: var(--accent-gold);
	}

	.personal-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
	}

	.personal-item {
		padding: 1rem;
		background: var(--surface);
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.personal-item:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
	}

	.personal-img {
		width: 100%;
		height: 140px;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: 0.75rem;
		transition: transform 0.3s ease;
	}

	.personal-item:hover .personal-img {
		transform: scale(1.05);
	}

	.personal-caption,
	.personal-text {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin: 0;
	}

	/* Footer */
	.footer {
		padding: 2rem 0;
		text-align: center;
		font-size: 0.75rem;
		color: var(--text-muted);
		border-top: 1px solid var(--border-light);
	}

	.footer a {
		color: var(--accent-lavender);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.nav {
			flex-direction: column;
			gap: 0.5rem;
			padding: 0.75rem 1rem;
		}

		.hero-header {
			flex-direction: column;
			text-align: center;
		}

		.hero h1 {
			font-size: 1.75rem;
		}

		.project-grid {
			grid-template-columns: 1fr;
		}

		.personal-grid {
			grid-template-columns: 1fr;
		}

		.birthday-counter {
			bottom: 1rem;
			right: 1rem;
		}
	}
</style>

<script>
  const birthday = new Date('2026-11-21T00:00:00');

  function updateBirthdayCounter() {
    const now = new Date();
    const difference = birthday.getTime() - now.getTime();

    const daysCountEl = document.getElementById('days-count');
    const birthdayCounterEl = document.querySelector('.birthday-counter');

    if (!daysCountEl || !birthdayCounterEl) return;

    if (difference <= 0) {
      birthdayCounterEl.textContent = 'i turned 21 today!';
      return;
    }

    const totalSeconds = Math.floor(difference / 1000);

    const days = Math.floor(totalSeconds / (60 * 60 * 24));
    const hours = Math.floor(
      (totalSeconds % (60 * 60 * 24)) / (60 * 60)
    );
    const minutes = Math.floor(
      (totalSeconds % (60 * 60)) / 60
    );
    const seconds = totalSeconds % 60;

    daysCountEl.textContent =
      `${days}d ${hours}h ${minutes}m`;
  }

  updateBirthdayCounter();
  setInterval(updateBirthdayCounter, 100000);
</script>