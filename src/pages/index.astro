---
import Layout from '../layouts/Layout.astro';
import GithubGraph from "../components/githubGraph.astro";

import { getGithubContributions } from "../lib/github";

const githubData = await getGithubContributions();
---

<Layout title="vidha">
	<!-- Navigation -->
	<nav class="nav">
		<div class="nav-inner container-wide">
			<div class="nav-top">
				<GithubGraph data={githubData} />
			</div>
			<div class="nav-bottom">
				<div class="nav-left">
					<span class="mono-accent">vidha</span>
					<span class="nav-separator mono">/</span>
					<a href="https://github.com/vidha" target="_blank" rel="noopener" class="mono">github</a>
					<span class="nav-separator mono">/</span>
					<a href="https://x.com/vidha" target="_blank" rel="noopener" class="mono">x</a>
					<span class="nav-separator mono">/</span>
					<a href="https://linkedin.com/in/vidha" target="_blank" rel="noopener" class="mono">linkedin</a>
					<span class="nav-separator mono">/</span>
					<a href="mailto:hello@vidha.com" class="mono">email</a>
				</div>
				<div class="nav-right">
					<a href="#contact" class="mono-accent">[ CONNECT ]</a>
				</div>
			</div>
		</div>
	</nav>

	<!-- Birthday Counter -->
	<div class="birthday-counter mono">
		<span id="days-count">[dynamic]</span> till i turn 21
	</div>

	<!-- Hero -->
	<section class="hero container-wide">
		<div class="hero-layout">
			<!-- Left: Profile + Metadata -->
			<div class="hero-left">
				<div class="profile-section">
					<img src="../src/images/pfp.jpeg" alt="vidha" class="profile-pic" />
				</div>
				
				<div class="inspection-panel">
					<div class="inspection-row">
						<span class="inspection-label mono">IDENTITY</span>
						<span class="inspection-value">VIDHA SINGH CHAUHAN</span>
					</div>
					<div class="inspection-row">
						<span class="inspection-label mono">ROLE</span>
						<span class="inspection-value">SOFTWARE DEVELOPER</span>
					</div>
					<div class="inspection-row">
						<span class="inspection-label mono">EXPERIENCE</span>
						<span class="inspection-value">03+ YEARS</span>
					</div>
					<div class="inspection-row">
						<span class="inspection-label mono">STATUS</span>
						<span class="inspection-value status-building">
							<span class="status-dot"></span>
							BUILDING
						</span>
					</div>
				</div>
			</div>

			<!-- Right: Statement -->
			<div class="hero-right">
				<div class="hero-statement">
					<p class="hero-intro">i build and ship things on the internet.</p>
					<p class="hero-intro">usually something i probably didn't need to build.</p>
				</div>

				<!-- Contexta Status -->
				<div class="current-system">
					<div class="system-header">
						<span class="mono">CURRENT SYSTEM</span>
						<span class="status-indicator mono status-building">● ACTIVE</span>
					</div>
					<div class="system-body">
						<h3>contexta</h3>
						<p class="mono">memory layer for codebases</p>
						<div class="system-meta">
							<span class="mono">FOUNDER · CEO</span>
							<span class="mono">2026</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Projects -->
	<section class="projects container-wide">
		<div class="projects-header">
			<h2>projects</h2>
			<p class="mono">SYSTEM INSPECTION</p>
		</div>
		
		<div class="projects-list">
			<!-- Contexta - Primary -->
			<div class="project-panel project-primary">
				<div class="panel-header">
					<div class="panel-title">
						<span class="mono">PROJECT</span>
						<h3>contexta</h3>
					</div>
					<div class="panel-status">
						<span class="mono status-building">● BUILDING</span>
					</div>
				</div>
				<div class="panel-body">
					<div class="panel-grid">
						<div class="panel-main">
							<p class="project-desc">a memory layer for codebases</p>
							<div class="panel-meta">
								<div class="meta-row">
									<span class="mono">YEAR</span>
									<span class="mono">2026</span>
								</div>
								<div class="meta-row">
									<span class="mono">ROLE</span>
									<span class="mono">FOUNDER · DEVELOPER</span>
								</div>
								<div class="meta-row">
									<span class="mono">STACK</span>
									<span class="mono">PYTHON · FASTAPI · SUPABASE</span>
								</div>
							</div>
						</div>
						<div class="panel-actions">
							<a href="#" class="mono-accent">[ LIVE ]</a>
							<a href="https://github.com/vidha/contexta" target="_blank" rel="noopener" class="mono-accent">[ GITHUB ]</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Skippit -->
			<div class="project-panel">
				<div class="panel-header">
					<div class="panel-title">
						<span class="mono">PROJECT</span>
						<h3>skippit</h3>
					</div>
					<div class="panel-status">
						<span class="mono">● COMPLETE</span>
					</div>
				</div>
				<div class="panel-body">
					<div class="panel-grid">
						<div class="panel-main">
							<p class="project-desc">async interviews for startups</p>
							<div class="panel-meta">
								<div class="meta-row">
									<span class="mono">YEAR</span>
									<span class="mono">2025</span>
								</div>
								<div class="meta-row">
									<span class="mono">ROLE</span>
									<span class="mono">DEVELOPER</span>
								</div>
								<div class="meta-row">
									<span class="mono">STACK</span>
									<span class="mono">PYTHON · FLASK · WEBRTC</span>
								</div>
							</div>
						</div>
						<div class="panel-actions">
							<a href="#" class="mono-accent">[ LIVE ]</a>
							<a href="https://github.com/vidha/skippit" target="_blank" rel="noopener" class="mono-accent">[ GITHUB ]</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Ditto -->
			<div class="project-panel">
				<div class="panel-header">
					<div class="panel-title">
						<span class="mono">PROJECT</span>
						<h3>ditto</h3>
					</div>
					<div class="panel-status">
						<span class="mono">● COMPLETE</span>
					</div>
				</div>
				<div class="panel-body">
					<div class="panel-grid">
						<div class="panel-main">
							<p class="project-desc">screenshots → useful information</p>
							<div class="panel-meta">
								<div class="meta-row">
									<span class="mono">YEAR</span>
									<span class="mono">2025</span>
								</div>
								<div class="meta-row">
									<span class="mono">ROLE</span>
									<span class="mono">DEVELOPER</span>
								</div>
								<div class="meta-row">
									<span class="mono">STACK</span>
									<span class="mono">PYTHON · FASTAPI · TESSERACT</span>
								</div>
							</div>
						</div>
						<div class="panel-actions">
							<a href="#" class="mono-accent">[ LIVE ]</a>
							<a href="https://github.com/vidha/ditto" target="_blank" rel="noopener" class="mono-accent">[ GITHUB ]</a>
						</div>
					</div>
				</div>
			</div>

			<!-- SnapTunnel -->
			<div class="project-panel">
				<div class="panel-header">
					<div class="panel-title">
						<span class="mono">PROJECT</span>
						<h3>snaptunnel</h3>
					</div>
					<div class="panel-status">
						<span class="mono">● COMPLETE</span>
					</div>
				</div>
				<div class="panel-body">
					<div class="panel-grid">
						<div class="panel-main">
							<p class="project-desc">peer-to-peer file sharing</p>
							<div class="panel-meta">
								<div class="meta-row">
									<span class="mono">YEAR</span>
									<span class="mono">2025</span>
								</div>
								<div class="meta-row">
									<span class="mono">ROLE</span>
									<span class="mono">DEVELOPER</span>
								</div>
								<div class="meta-row">
									<span class="mono">STACK</span>
									<span class="mono">JAVASCRIPT · WEBTORRENT · WEBRTC</span>
								</div>
							</div>
						</div>
						<div class="panel-actions">
							<a href="#" class="mono-accent">[ LIVE ]</a>
							<a href="https://github.com/vidha/snaptunnel" target="_blank" rel="noopener" class="mono-accent">[ GITHUB ]</a>
						</div>
					</div>
				</div>
			</div>

			<!-- TicketLedger -->
			<div class="project-panel">
				<div class="panel-header">
					<div class="panel-title">
						<span class="mono">PROJECT</span>
						<h3>ticketledger</h3>
					</div>
					<div class="panel-status">
						<span class="mono">● COMPLETE</span>
					</div>
				</div>
				<div class="panel-body">
					<div class="panel-grid">
						<div class="panel-main">
							<p class="project-desc">decentralized ticketing on aptos</p>
							<div class="panel-meta">
								<div class="meta-row">
									<span class="mono">YEAR</span>
									<span class="mono">2025</span>
								</div>
								<div class="meta-row">
									<span class="mono">ROLE</span>
									<span class="mono">DEVELOPER</span>
								</div>
								<div class="meta-row">
									<span class="mono">STACK</span>
									<span class="mono">MOVE · APTOS · TYPESCRIPT</span>
								</div>
							</div>
						</div>
						<div class="panel-actions">
							<a href="#" class="mono-accent">[ LIVE ]</a>
							<a href="https://github.com/vidha/ticketledger" target="_blank" rel="noopener" class="mono-accent">[ GITHUB ]</a>
						</div>
					</div>
				</div>
			</div>
		</div>

		<a href="/work" class="see-more mono-accent">[ VIEW ALL SYSTEMS ]</a>
	</section>

	<!-- Experience -->
	<section class="experience container-wide">
		<div class="experience-header">
			<h2>experience</h2>
			<p class="mono">ENGINEERING HISTORY</p>
		</div>
		
		<div class="experience-timeline">
			<div class="timeline-entry">
				<div class="timeline-marker mono">2026</div>
				<div class="timeline-content">
					<div class="timeline-header">
						<h3>contexta</h3>
						<span class="mono status-building">● ACTIVE</span>
					</div>
					<p class="mono">FOUNDER · CEO</p>
					<p class="timeline-desc">building a memory layer for codebases</p>
				</div>
			</div>

			<div class="timeline-entry">
				<div class="timeline-marker mono">2025</div>
				<div class="timeline-content">
					<div class="timeline-header">
						<h3>[company name]</h3>
						<span class="mono">● COMPLETE</span>
					</div>
					<p class="mono">[role]</p>
					<p class="timeline-desc">1–2 lines describing what you actually worked on</p>
				</div>
			</div>
		</div>

		<a href="/work" class="see-more mono-accent">[ VIEW FULL HISTORY ]</a>
	</section>

	<!-- Contact -->
	<section class="contact container-wide" id="contact">
		<div class="contact-panel">
			<div class="panel-header">
				<span class="mono">SYSTEM ACTION</span>
				<span class="mono">● READY</span>
			</div>
			<div class="panel-body">
				<h2>ready to connect?</h2>
				<p class="contact-desc">i build web apps, backend systems, APIs, internal tools, MVPs and automations for startups and other people building things.</p>
				<a href="mailto:hello@vidha.com" class="system-button mono-accent">[ SEND MESSAGE ]</a>
			</div>
		</div>
	</section>

	<!-- Communities -->
	<section class="communities container-medium">
		<div class="communities-header">
			<h2>communities</h2>
			<p class="mono">SECONDARY CONTEXT</p>
		</div>
		
		<div class="community-list">
			<div class="community-item">
				<div class="community-main">
					<h3>eis</h3>
					<p class="mono">GENERAL SECRETARY</p>
					<p class="community-desc">building entrepreneurship and innovation at university</p>
				</div>
			</div>

			<div class="community-item">
				<div class="community-main">
					<h3>accelerate</h3>
					<p class="mono">FOUNDER</p>
					<p class="community-desc">builder community around open source and collaboration</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Personal -->
	<section class="personal container-narrow">
		<div class="personal-header">
			<h2>beyond code</h2>
			<p class="mono">ADDITIONAL CONTEXT</p>
		</div>
		
		<div class="personal-list">
			<div class="personal-item">
				<p class="mono">music · video editing · reading · random experiments · cats</p>
				<p class="personal-note">and approximately 47 unfinished side projects.</p>
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="footer container-wide">
		<div class="footer-inner">
			<p class="mono">© 2026 vidha · <a href="https://github.com/vidha/portfolio" target="_blank" rel="noopener">[ SOURCE ]</a></p>
		</div>
	</footer>
</Layout>

<style>
	/* Navigation */
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		background: var(--bg-secondary);
		border-bottom: 1px solid var(--border-medium);
		z-index: 100;
	}

	.nav-inner {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.75rem 0;
	}

	.nav-top {
		display: flex;
		justify-content: center;
	}

	.nav-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav-left,
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-separator {
		color: var(--text-tertiary);
		font-size: 0.75rem;
	}

	/* Birthday Counter */
	.birthday-counter {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		font-size: 0.6875rem;
		color: var(--text-tertiary);
		background: var(--bg-secondary);
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--border-subtle);
		border-radius: 2px;
	}

	/* Hero */
	.hero {
		padding: 8rem 0 6rem;
		border-bottom: 1px solid var(--border-subtle);
	}

	.hero-layout {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: 4rem;
		align-items: start;
	}

	.hero-left {
		position: sticky;
		top: 6rem;
	}

	.profile-section {
		margin-bottom: 2rem;
	}

	.profile-pic {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--border-medium);
	}

	.inspection-panel {
		background: var(--bg-secondary);
		border: 1px solid var(--border-subtle);
		border-radius: 4px;
		padding: 1.5rem;
	}

	.inspection-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--border-subtle);
	}

	.inspection-row:last-child {
		border-bottom: none;
	}

	.inspection-label {
		font-size: 0.6875rem;
		color: var(--text-tertiary);
		letter-spacing: 0.05em;
	}

	.inspection-value {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--text-primary);
	}

	.status-building {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.status-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--status-green);
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.5; }
	}

	.hero-right {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.hero-statement {
		padding: 2rem 0;
		border-top: 1px solid var(--border-subtle);
	}

	.hero-intro {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
		color: var(--text-primary);
		line-height: 1.4;
	}

	.current-system {
		background: var(--bg-secondary);
		border: 1px solid var(--border-medium);
		border-radius: 4px;
		overflow: hidden;
	}

	.system-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1rem;
		background: var(--bg-tertiary);
		border-bottom: 1px solid var(--border-subtle);
	}

	.status-indicator {
		font-size: 0.6875rem;
	}

	.status-building {
		color: var(--status-green);
	}

	.system-body {
		padding: 1.5rem;
	}

	.system-body h3 {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
	}

	.system-body p {
		font-size: 0.875rem;
		margin-bottom: 1rem;
	}

	.system-meta {
		display: flex;
		gap: 1rem;
		font-size: 0.75rem;
		color: var(--text-tertiary);
	}


	/* Projects */
	.projects {
		padding: 6rem 0;
	}

	.projects-header {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 3rem;
		border-bottom: 1px solid var(--border-subtle);
		padding-bottom: 1rem;
	}

	.projects-header h2 {
		margin-bottom: 0;
	}

	.projects-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.project-panel {
		background: var(--bg-secondary);
		border: 1px solid var(--border-subtle);
		border-radius: 4px;
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	.project-panel:hover {
		border-color: var(--border-medium);
	}

	.project-primary {
		border-color: var(--border-medium);
	}

	.panel-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1rem;
		background: var(--bg-tertiary);
		border-bottom: 1px solid var(--border-subtle);
	}

	.panel-title {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.panel-title span {
		font-size: 0.6875rem;
		color: var(--text-tertiary);
	}

	.panel-title h3 {
		font-size: 1.125rem;
		margin-bottom: 0;
	}

	.panel-status {
		font-size: 0.6875rem;
	}

	.status-building {
		color: var(--status-green);
	}

	.panel-body {
		padding: 1.5rem;
	}

	.panel-grid {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
	}

	.panel-main {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.project-desc {
		font-size: 0.9375rem;
		color: var(--text-secondary);
		margin: 0;
	}

	.panel-meta {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.meta-row {
		display: flex;
		gap: 1rem;
	}

	.meta-row span:first-child {
		color: var(--text-tertiary);
		min-width: 60px;
	}

	.panel-actions {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-self: start;
	}

	.see-more {
		display: inline-block;
		margin-top: 2rem;
	}

	/* Experience */
	.experience {
		padding: 6rem 0;
	}

	.experience-header {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 3rem;
		border-bottom: 1px solid var(--border-subtle);
		padding-bottom: 1rem;
	}

	.experience-header h2 {
		margin-bottom: 0;
	}

	.experience-timeline {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.timeline-entry {
		display: grid;
		grid-template-columns: 100px 1fr;
		gap: 2rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--border-subtle);
	}

	.timeline-entry:last-child {
		border-bottom: none;
	}

	.timeline-marker {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--text-tertiary);
		padding-top: 0.25rem;
	}

	.timeline-content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.timeline-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	.timeline-header h3 {
		font-size: 1.125rem;
		margin-bottom: 0;
	}

	.timeline-header span {
		font-size: 0.6875rem;
	}

	.timeline-content > p {
		margin-bottom: 0.25rem;
	}

	.timeline-desc {
		font-size: 0.875rem;
		color: var(--text-secondary);
		margin: 0;
	}

	/* Contact */
	.contact {
		padding: 6rem 0;
	}

	.contact-panel {
		background: var(--bg-secondary);
		border: 1px solid var(--border-medium);
		border-radius: 4px;
		overflow: hidden;
		max-width: 600px;
		margin: 0 auto;
	}

	.contact-panel .panel-header {
		display: flex;
