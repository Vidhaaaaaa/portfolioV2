---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import GithubGraph from "../components/githubGraph.astro";
import { projects } from "../data/projects";
import { experiences } from "../data/experience";

import { getGithubContributions } from "../lib/github";

const githubData = await getGithubContributions();
const featuredProjects = projects.filter(p => p.featured);
---

<Layout title="vidha">
	<Navigation />

	<!-- Birthday Counter -->
	<div class="birthday-counter">
		<span id="days-count">[dynamic]</span> 
	</div>

	<!-- Hero -->
	<section class="hero container-wide">
		<div class="hero-content">

			<!-- Profile -->
			<div class="hero-title">
				<div class="hero-profile">
					<img src="../src/images/pfp.jpeg" alt="vidha" class="profile-pic" />
				</div>

				<!-- Name, Age & Role -->
				<div class="hero-name">
					Vidha Singh Chauhan
					<span class="hero-age">she/her</span>

					<!-- Role -->
					<div class="hero-role">
						Full Stack Developer&nbsp&nbsp·&nbsp&nbsp3+ years Building
					</div>
				</div>
			</div>

			<!-- Statement -->
			<div class="hero-statement">
				<p>i build and ship things on the internet.</p>
				<a href="" class="full-stack-link" >Need Something built? see what i can offer -></a>
			</div>


			<!-- Tech Skills -->
			<div class="hero-tech">
				<img src="../src/images/skills/python.png" alt="Python" class="skills-icon" />
				<div class="skill-icon flask-icon">
					<img src="../src/images/skills/flask.png" alt="Flask" />
				</div>
				<img src="../src/images/skills/fastapi.png" alt="FastAPI" class="skills-icon" />
				<img src="../src/images/skills/react.png" alt="React.js" class="skills-icon" />
				<img src="../src/images/skills/jinja.png" alt="Jinja" class="skills-icon" />
				<img src="../src/images/skills/MySQL.png" alt="MySQL" class="skills-icon" />
				<img src="../src/images/skills/postgresql.png" alt="PostgreSQL" class="skills-icon" />
			</div>

			<a href="/work" class="full-stack-link">
				see full stack →
			</a>

			<!-- Spotify + X -->
			<div class="hero-social">
				<a href="https://open.spotify.com/track/1Ot6UNRGj2aYS3xtqw1YtA?si=06650097919b440d" target="_blank" rel="noopener" class="social-link">
					<span class="social-icon">♫</span>
					<span class="social-detail mono">Ranjish Hi Sahi · Mehdi Hassan</span>
				</a>
			</div>

			<!-- GitHub Activity -->
			<div class="hero-github">
				<GithubGraph data={githubData} />
			</div>
			<a href="#projects-header" class="scroll-down-link">
				see projects and experience ↓
			</a>
		</div>
	</section>

	<!-- Projects -->
	<section class="projects container-wide" id="projects">
		<div class="projects-header" id="projects-header">
			<h2>Featured Projects</h2>
		</div>
		
		<div class="projects-list">
			{featuredProjects.map((project) => (
				<div class="project-item">
					<div class="project-top">
						<a href="/projects" class="project-title-link">
							<h3 class="project-title">{project.title}</h3>
						</a>
						<div class="project-top-meta">
							{project.currently && (
								<span class="status-tag mono">ongoing</span>
							)}
						</div>
					</div>
					<div class="project-bottom">
						<p class="project-desc">{project.description}</p>
						<div class="project-links">
							{project.github && (
								<a href={project.github} target="_blank" rel="noopener" class="project-link mono">GitHub →</a>
							)}
							{project.live && (
								<a href={project.live} target="_blank" rel="noopener" class="project-link mono">Live →</a>
							)}
						</div>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- Experience -->
	<section class="experience container-wide" id="experience">
		<div class="experience-header">
			<h2>Experience</h2>
		</div>
		
		<div class="timeline">
			{experiences.map((exp) => (
				<div class="timeline-item">
					<div class="timeline-marker" aria-hidden="true"></div>
					<div class="timeline-content">
						<div class="timeline-top">
							<div class="timeline-heading">
								<h3 class="timeline-company">{exp.company}</h3>
								<p class="timeline-role mono">{exp.role}</p>
							</div>
							<span class="timeline-date mono">{exp.date}</span>
						</div>
						<p class="timeline-desc">{exp.description}</p>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- Contact -->
	<section class="contact container-wide" id="contact">
			<div class="contact-box">
				<div class="contact-info">
					<p class="contact-eyebrow">get in touch</p>

					<h2>let's build something.</h2>

					<p class="contact-desc">
						Available for freelance development, collaborations, anything interesting.
						<p>or schedule a short 30 minute chat:  <a href="https://calendly.com/works-vidha/30min" target="_blank" rel="noopener noreferrer">
						Calendly ↗
						</a></p>
					</p>

					<div class="contact-links">
						<a href="mailto:works.vidha@gmail.com">Email ↗</a>
						<a href="https://github.com/Vidhaaaaaa" target="_blank" rel="noopener noreferrer">
						GitHub ↗
						</a>
						<a href="https://linkedin.com/in/vidhasinghchauhan" target="_blank" rel="noopener noreferrer">
						LinkedIn ↗
						</a>
						<a href="https://x.com/theidiotvidha" target="_blank" rel="noopener noreferrer">
						X ↗
						</a>
					</div>
				</div>

				<form class="contact-form" id="contactForm">
				<div class="form-field">
					<label for="name">name</label>
					<input
					type="text"
					id="name"
					name="name"
					placeholder="Your name"
					autocomplete="name"
					required
					/>
				</div>

				<div class="form-field">
					<label for="email">email</label>
					<input
					type="email"
					id="email"
					name="email"
					placeholder="you@example.com"
					autocomplete="email"
					required
					/>
				</div>

				<div class="form-field">
					<label for="message">message</label>
					<textarea
					id="message"
					name="message"
					rows="4"
					placeholder="Tell me what you're building..."
					required
					></textarea>
				</div>

				<button type="submit" id="submitBtn">
					send message <span>↗</span>
				</button>
				<p id="formStatus" class="form-status"></p>
			</form>
			</div>
	</section>

	<!-- Footer -->
	<footer class="footer container-wide">
		<div class="footer-content">
			<div class="footer-links">
				<a href="https://github.com/Vidhaaaaaa" target="_blank" rel="noopener">GitHub</a>
				<a href="https://linkedin.com/in/vidhasinghchauhan" target="_blank" rel="noopener">LinkedIn</a>
				<a href="https://x.com/theidiotvidha" target="_blank" rel="noopener">X</a>
				<a href="mailto:works.vidha@gmail.com">Email</a>
			</div>
			<div class="footer-copy">
				<p class="mono">© 2026 Vidha</p>
			</div>
		</div>
	</footer>
</Layout>

<style>
	/* Birthday Counter */
	.birthday-counter {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--text-primary);
		background: var(--bg-secondary);
		padding: 0.375rem 0.625rem;
		border: 1px solid var(--border-medium);
		border-radius: 0;
		z-index: 50;
	}

	.days-count-text {
		font-size: 0.5rem;
		font-weight: 500;
	}

	/* Hero */
	.hero {
		padding: 3rem 0 2rem;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
		margin-top: 10rem;
		row-gap: 2rem;
	}

	.hero-github {
		margin-bottom: 0.75rem;
	}

	.hero-title {
		display: flex;
		gap: 1rem;
		justify-content: space-between;
	}

	.hero-profile {
		margin-bottom: 0.75rem;
	}

	.profile-pic {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		object-fit: cover;
	}

	.hero-name {
		font-size: 2rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		margin-bottom: 0.5rem;
	}

	.hero-age {
		font-size: 1.25rem;
		color: var(--text-secondary);
		margin-left: 0.5rem;
	}

	.hero-statement {
		max-width: 600px;
		margin-bottom: 0.75rem;
	}

	.hero-statement p {
		font-size: 0.9375rem;
		line-height: 1.5;
		margin-bottom: 0.25rem;
	}

	.hero-role {
		font-size: 0.8200rem;
		color: var(--text-secondary);
		margin-bottom: 0.1rem;
		margin-left: 0.5rem;
		text-align: left;
	}

	.hero-tech {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.skills-icon {
		width: 45px;
		height: 45px;
		object-fit: contain;
		display: block;
		opacity: 0.7;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.skills-icon:hover {
		opacity: 1;
		transform: translateY(-2px);
	}

	.skill-icon {
		width: 45px;
		height: 45px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.flask-icon {
		width: 45px;
		height: 45px;
		background: var(--text-primary);
		border-radius: 25%;
		padding: 4px;
	}

	.flask-icon img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	.full-stack-link {
		font-size: 0.75rem;
		color: var(--text-secondary);
		text-decoration: none;
		margin-bottom: 0.75rem;
		transition: color 0.2s ease;
	}

	.full-stack-link:hover {
		color: var(--text-primary);
	}

	.tech-icon {
		font-size: 0.8125rem;
		color: var(--text-tertiary);
		padding: 0.375rem 0.75rem;
		background: var(--bg-tertiary);
		border-radius: 4px;
	}

	.hero-social {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.social-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--text-tertiary);
		transition: color 0.2s ease;
	}

	.social-link:hover {
		color: var(--text-primary);
	}

	.social-icon {
		font-size: 1rem;
	}

	.social-detail {
		font-size: 0.75rem;
	}

	.scroll-down-link {
		font-size: 1rem;
		color: var(--text-secondary);
		text-decoration: none;
		margin-bottom: 0.75rem;
		transition: color 0.2s ease;
		-webkit-animation: sdl 2s infinite;
		animation: sdl 2s infinite;
	}

	@-webkit-keyframes sdl {
		0% {
			-webkit-transform: translate(0, 0);
		}
		20% {
			-webkit-transform: translate(0px, 10px);
		}
		40% {
			-webkit-transform: translate(0, 0);
		}
	}

	@keyframes sdl {
		0% {
			transform: translate(0, 0);
		}
		20% {
			transform: translate(0px, 10px);
		}
		40% {
			transform: translate(0, 0);
		}
	}

	

	/* Projects */
	.projects {
		padding: 1.5rem 0;
	}

	.projects-header {
		margin-bottom: 1rem;
	}

	.projects-header h2 {
		margin-bottom: 0;
	}

	.projects-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.project-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--border-subtle);
	}

	.project-item:last-child {
		border-bottom: none;
	}

	.project-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	.project-title {
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: 0;
		line-height: 1.3;
	}

	.project-title-link {
		text-decoration: none;
		color: inherit;
		transition: color 0.2s ease;
	}

	.project-title-link:hover .project-title {
		color: var(--text-secondary);
	}

	.project-top-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.status-tag {
		font-size: 0.6875rem;
		color: var(--text-secondary);
		background: var(--bg-tertiary);
		border: 1px solid var(--border-subtle);
		padding: 0.125rem 0.45rem;
		line-height: 1.2;
		letter-spacing: 0.02em;
	}

	.project-date {
		font-size: 0.75rem;
		color: var(--text-tertiary);
		white-space: nowrap;
	}

	.project-bottom {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	.project-desc {
		font-size: 0.8125rem;
		color: var(--text-secondary);
		margin: 0;
		line-height: 1.5;
	}

	.project-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.project-link {
		font-size: 0.75rem;
		color: var(--text-secondary);
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.project-link:hover {
		color: var(--text-primary);
	}

	/* Experience Timeline */
	.experience {
		padding: 1.5rem 0;
	}

	.experience-header {
		margin-bottom: 1.5rem;
	}

	.experience-header h2 {
		margin-bottom: 0;
	}

	.timeline {
		position: relative;
		padding-left: 1.5rem;
	}

	.timeline-item {
		position: relative;
		padding-bottom: 2rem;
	}

	.timeline-item:last-child {
		padding-bottom: 0;
	}

	/* Connecting vertical line */
	.timeline-item::before {
		content: '';
		position: absolute;
		left: -1.5rem;
		top: 0.5rem;
		bottom: -0.5rem;
		width: 1px;
		background: var(--border-subtle);
		margin-left: 3px;
	}

	.timeline-item:last-child::before {
		display: none;
	}

	/* Timeline dot/marker */
	.timeline-marker {
		position: absolute;
		left: -1.5rem;
		top: 0.4rem;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--text-tertiary);
	}

	.timeline-content {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.timeline-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	.timeline-heading {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.timeline-company {
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: 0;
		line-height: 1.3;
	}

	.timeline-role {
		font-size: 0.8125rem;
		color: var(--text-secondary);
		margin-bottom: 0;
	}

	.timeline-date {
		font-size: 0.75rem;
		color: var(--text-tertiary);
		white-space: nowrap;
		text-align: right;
		flex-shrink: 0;
	}

	.timeline-desc {
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin: 0;
	}
	}

	/* Contact */
.contact {
  padding: 3rem 0 4rem;
  width: 100%;
  
}

.contact-box {
margin-top: 3rem;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;

  border: 1px solid var(--border);
  border-radius: 16px;

  /* outer box */
  background: var(--surface);
  overflow: hidden;
}

/* LEFT SIDE */

.contact-info {
  padding: 3rem;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  background: var(--surface);
}

.contact-eyebrow {
  margin: 0 0 1.5rem;

  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;

  color: var(--text-secondary);
}

.contact-info h2 {
  margin: 0 0 1rem;

  font-size: clamp(2rem, 4vw, 3.25rem);
  line-height: 1;
  letter-spacing: -0.045em;
  font-weight: 500;
}

.contact-desc {
  max-width: 380px;
  margin: 0;

  font-size: 0.85rem;
  line-height: 1.7;

  color: var(--text-secondary);
}

.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;

  margin-top: 2.5rem;
}

.contact-links a {
  font-size: 0.72rem;
  color: var(--text-secondary);
  text-decoration: none;

  transition: color 0.2s ease;
}

.contact-links a:hover {
  color: var(--text-primary);
}


/* VERTICAL SEPARATOR + FORM */

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.35rem;

  padding: 3rem;

  background: var(--background);

  width: 100%;
  box-sizing: border-box;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-field label {
  font-size: 0.65rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;

  color: var(--text-secondary);
}

.form-field input,
.form-field textarea {
  width: 100%;
  box-sizing: border-box;

  padding: 0.8rem;

  border: none;

  background: var(--bg-primary);

  color: var(--text-primary);

  font: inherit;
  font-size: 0.82rem;

  outline: none;

  transition: border-color 0.2s ease;
}

.form-field textarea {
  min-height: 100px;
  resize: vertical;
}

.form-field input::placeholder,
.form-field textarea::placeholder {
  color: var(--text-secondary);
  opacity: 0.45;
}

.form-field input:focus,
.form-field textarea:focus {
  border-bottom-color: var(--text-primary);
}

.contact-form button {
  align-self: flex-start;

  margin-top: 0.2rem;
  padding: 0.7rem;

  border: none;
  border-radius: 12px;
  background: var(--bg-primary);

  color: var(--text-primary);

  font: inherit;
  font-size: 0.75rem;
  font-weight: 500;

  cursor: pointer;

  transition: opacity 0.2s ease;
}

.contact-form button span {
  display: inline-block;
  margin-left: 0.25rem;

  transition: transform 0.2s ease;
}

.contact-form button:hover {
  opacity: 0.6;
}

.contact-form button:hover span {
  transform: translate(3px, -3px);
}

.form-status {
  margin-top: 1rem;
  font-size: 0.875rem;
  min-height: 1.25rem;
}

.form-status.success {
  color: #10b981;
}

.form-status.error {
  color: #ef4444;
}

/* MOBILE */

@media (max-width: 700px) {
  .contact {
    padding: 2rem 0 3rem;
  }

  .contact-box {
    grid-template-columns: 1fr;
    border-radius: 12px;
  }

  .contact-info {
    padding: 2rem 1.5rem;
  }

  .contact-form {
    padding: 2rem 1.5rem;
    border-left: none;
    border-top: 1px solid var(--border);
  }

  .contact-info h2 {
    font-size: 2.25rem;
  }

  .contact-links {
    margin-top: 2rem;
  }
}
	
	

	/* Footer */
	.footer {
		padding: 1rem 0 1.5rem;
		border-top: 1px solid var(--border-subtle);
		margin-top: 5rem;
	}

	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-personal {
		font-size: 0.75rem;
		color: var(--text-tertiary);
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.footer-links a {
		font-size: 0.75rem;
		color: var(--text-secondary);
	}

	.footer-links a:hover {
		color: var(--text-primary);
	}

	.footer-copy {
		font-size: 0.6875rem;
		color: var(--text-tertiary);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.nav-inner {
			flex-direction: column;
			gap: 0.75rem;
			padding: 0.75rem 0;
		}

		.nav-center {
			display: none;
		}

		.nav-left,
		.nav-right {
			flex-wrap: wrap;
			justify-content: center;
		}

		.hero-content {
			gap: 1.5rem;
		}

		.hero-name {
			font-size: 2rem;
		}

		.hero-age {
			font-size: 1.25rem;
		}

		.hero-statement p {
			font-size: 1rem;
		}

		@media (max-width: 768px) {
			.hero-tech {
				gap: 0.75rem;
			}

			.skills-icon {
				width: 20px;
				height: 20px;
			}
