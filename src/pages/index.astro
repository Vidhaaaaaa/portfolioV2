---
import Layout from '../layouts/Layout.astro';
import GithubGraph from "../components/githubGraph.astro";

import { getGithubContributions } from "../lib/github";

const githubData = await getGithubContributions();
---

<Layout title="vidha">
	<!-- Navigation -->
	<nav class="nav">
		<div class="nav-inner container-wide">
			<div class="nav-left">
				<a href="/" class="nav-name">VIDHA</a>
			</div>
			<div class="nav-center">
				<a href="src\pages\about.astro" target="_blank" rel="noopener">About</a>
				<a href="src\pages\experience.astro" target="_blank" rel="noopener">Experience</a>
				<a href="src\pages\projects.astro" target="_blank" rel="noopener">Projects</a>
			</div>
			<div class="nav-right">
				<a href="#contact" class="nav-cta">Work with me →</a>
				<button class="theme-toggle" aria-label="Toggle theme">◐</button>
			</div>
		</div>
	</nav>

	<!-- Birthday Counter -->
	<div class="birthday-counter">
		<span id="days-count">[dynamic]</span> 
	</div>

	<!-- Hero -->
	<section class="hero container-wide">
		<div class="hero-content">

			<!-- Profile -->
			<div class="hero-title">
				<div class="hero-profile">
					<img src="../src/images/pfp.jpeg" alt="vidha" class="profile-pic" />
				</div>

				<!-- Name, Age & Role -->
				<div class="hero-name">
					Vidha Singh Chauhan
					<span class="hero-age">she/her</span>

					<!-- Role -->
					<div class="hero-role">
						Full Stack Developer&nbsp&nbsp·&nbsp&nbsp3+ years Building
					</div>
				</div>
			</div>

			<!-- Statement -->
			<div class="hero-statement">
				<p>i build and ship things on the internet.</p>
				<p>usually something i probably didn't need to build.</p>
			</div>


			<!-- Tech Skills -->
			<div class="hero-tech">
				<img src="../src/images/skills/python.png" alt="Python" class="skills-icon" />
				<div class="skill-icon flask-icon">
					<img src="../src/images/skills/flask.png" alt="Flask" />
				</div>
				<img src="../src/images/skills/fastapi.png" alt="FastAPI" class="skills-icon" />
				<img src="../src/images/skills/react.png" alt="React.js" class="skills-icon" />
				<img src="../src/images/skills/jinja.png" alt="Jinja" class="skills-icon" />
				<img src="../src/images/skills/MySQL.png" alt="MySQL" class="skills-icon" />
				<img src="../src/images/skills/postgresql.png" alt="PostgreSQL" class="skills-icon" />
			</div>

			<a href="/work" class="full-stack-link">
				see full stack →
			</a>

			<!-- Spotify + X -->
			<div class="hero-social">
				<a href="https://open.spotify.com" target="_blank" rel="noopener" class="social-link">
					<span class="social-icon">♫</span>
					<span class="social-detail mono">Ranjish Hi Sahi · Mehdi Hassan</span>
				</a>
			</div>

			<!-- GitHub Activity -->
			<div class="hero-github">
				<GithubGraph data={githubData} />
			</div>
			<a href="#projects" class="scroll-down-link">
				see projects and experience ↓
			</a>
		</div>
	</section>

	<!-- Projects -->
	<section class="projects container-wide">
		<div class="projects-header">
			<h2>projects</h2>
		</div>
		
		<div class="projects-list">
			<!-- Contexta - Primary -->
			<div class="project-item project-featured">
				<div class="project-main">
					<h3>contexta</h3>
					<p class="project-desc">a memory layer for codebases</p>
					<div class="project-tech">
						<span class="tech-tag mono">Python</span>
						<span class="tech-tag mono">FastAPI</span>
						<span class="tech-tag mono">Supabase</span>
					</div>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">Live →</a>
					<a href="https://github.com/vidha/contexta" target="_blank" rel="noopener" class="project-link">GitHub</a>
				</div>
			</div>

			<!-- Skippit -->
			<div class="project-item">
				<div class="project-main">
					<h3>skippit</h3>
					<p class="project-desc">async interviews for startups</p>
					<div class="project-tech">
						<span class="tech-tag mono">Python</span>
						<span class="tech-tag mono">Flask</span>
						<span class="tech-tag mono">WebRTC</span>
					</div>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">Live →</a>
					<a href="https://github.com/vidha/skippit" target="_blank" rel="noopener" class="project-link">GitHub</a>
				</div>
			</div>

			<!-- Ditto -->
			<div class="project-item">
				<div class="project-main">
					<h3>ditto</h3>
					<p class="project-desc">screenshots → useful information</p>
					<div class="project-tech">
						<span class="tech-tag mono">Python</span>
						<span class="tech-tag mono">FastAPI</span>
						<span class="tech-tag mono">Tesseract</span>
					</div>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">Live →</a>
					<a href="https://github.com/vidha/ditto" target="_blank" rel="noopener" class="project-link">GitHub</a>
				</div>
			</div>

			<!-- SnapTunnel -->
			<div class="project-item">
				<div class="project-main">
					<h3>snaptunnel</h3>
					<p class="project-desc">peer-to-peer file sharing</p>
					<div class="project-tech">
						<span class="tech-tag mono">JavaScript</span>
						<span class="tech-tag mono">WebTorrent</span>
						<span class="tech-tag mono">WebRTC</span>
					</div>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">Live →</a>
					<a href="https://github.com/vidha/snaptunnel" target="_blank" rel="noopener" class="project-link">GitHub</a>
				</div>
			</div>

			<!-- TicketLedger -->
			<div class="project-item">
				<div class="project-main">
					<h3>ticketledger</h3>
					<p class="project-desc">decentralized ticketing on aptos</p>
					<div class="project-tech">
						<span class="tech-tag mono">Move</span>
						<span class="tech-tag mono">Aptos</span>
						<span class="tech-tag mono">TypeScript</span>
					</div>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">Live →</a>
					<a href="https://github.com/vidha/ticketledger" target="_blank" rel="noopener" class="project-link">GitHub</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Experience -->
	<section class="experience container-wide">
		<div class="experience-header">
			<h2>experience</h2>
		</div>
		
		<div class="experience-list">
			<div class="experience-item">
				<div class="experience-main">
					<h3>contexta</h3>
					<p class="experience-role mono">founder & ceo</p>
					<p class="experience-date mono">may 2026–present</p>
				</div>
			</div>

			<div class="experience-item">
				<div class="experience-main">
					<h3>[company name]</h3>
					<p class="experience-role mono">[role]</p>
					<p class="experience-date mono">[year/date]</p>
					<p class="experience-desc">1–2 lines describing what you actually worked on</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Contact -->
	<section class="contact container-wide" id="contact">
		<div class="contact-content">
			<h2>let's build something.</h2>
			<p class="contact-desc">Available for freelance development, collaborations, and interesting software projects.</p>
			
			<form class="contact-form">
				<div class="form-group">
					<label for="name" class="form-label mono">Name</label>
					<input type="text" id="name" name="name" class="form-input" required />
				</div>
				<div class="form-group">
					<label for="email" class="form-label mono">Email</label>
					<input type="email" id="email" name="email" class="form-input" required />
				</div>
				<div class="form-group">
					<label for="message" class="form-label mono">What can I help with?</label>
					<textarea id="message" name="message" class="form-input form-textarea" rows="4" required></textarea>
				</div>
				<button type="submit" class="form-submit">Send message →</button>
			</form>
			
			<p class="contact-email mono">or email directly: <a href="mailto:hello@vidha.com">hello@vidha.com</a></p>
		</div>
	</section>

	<!-- Communities -->
	<section class="communities container-wide">
		<div class="communities-header">
			<h2>communities</h2>
		</div>
		
		<div class="community-list">
			<div class="community-item">
				<h3>eis</h3>
				<p class="mono">general secretary</p>
				<p class="community-desc">building entrepreneurship and innovation at university</p>
			</div>

			<div class="community-item">
				<h3>accelerate</h3>
				<p class="mono">founder</p>
				<p class="community-desc">builder community around open source and collaboration</p>
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="footer container-wide">
		<div class="footer-content">
			<div class="footer-personal">
				<p class="mono">guitar · music · video · books</p>
			</div>
			<div class="footer-links">
				<a href="https://github.com/vidha" target="_blank" rel="noopener">GitHub</a>
				<a href="https://linkedin.com/in/vidha" target="_blank" rel="noopener">LinkedIn</a>
				<a href="https://x.com/vidha" target="_blank" rel="noopener">X</a>
				<a href="mailto:hello@vidha.com">Email</a>
				<a href="https://github.com/vidha/portfolio" target="_blank" rel="noopener">Open source</a>
			</div>
			<div class="footer-copy">
				<p class="mono">© 2026 vidha</p>
			</div>
		</div>
	</footer>
</Layout>

<style>
	/* Navigation */
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		background: var(--bg-primary);
		border-bottom: 1px solid var(--border-subtle);
		z-index: 100;
	}

	.nav-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 0;
	}

	.nav-left,
	.nav-center,
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.nav-name {
		font-weight: 600;
		font-size: 0.875rem;
		letter-spacing: -0.02em;
	}

	.nav-center a {
		font-size: 0.75rem;
		color: var(--text-secondary);
	}

	.nav-center a:hover {
		color: var(--text-primary);
	}

	.nav-cta {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--text-primary);
	}

	.theme-toggle {
		background: none;
		border: none;
		color: var(--text-tertiary);
		font-size: 1.25rem;
		cursor: pointer;
		padding: 0.25rem;
		transition: color 0.2s ease;
	}

	.theme-toggle:hover {
		color: var(--text-primary);
	}

	/* Birthday Counter */
	.birthday-counter {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--text-primary);
		background: var(--bg-secondary);
		padding: 0.375rem 0.625rem;
		border: 1px solid var(--border-medium);
		border-radius: 0;
		z-index: 50;
	}

	.days-count-text {
		font-size: 0.5rem;
		font-weight: 500;
	}

	/* Hero */
	.hero {
		padding: 3rem 0 2rem;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
		margin-top: 10rem;
		row-gap: 2rem;
	}

	.hero-github {
		margin-bottom: 0.75rem;
	}

	.hero-title {
		display: flex;
		gap: 1rem;
		justify-content: space-between;
	}

	.hero-profile {
		margin-bottom: 0.75rem;
	}

	.profile-pic {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		object-fit: cover;
	}

	.hero-name {
		font-size: 2rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		margin-bottom: 0.5rem;
	}

	.hero-age {
		font-size: 1.25rem;
		color: var(--text-secondary);
		margin-left: 0.5rem;
	}

	.hero-statement {
		max-width: 600px;
		margin-bottom: 0.75rem;
	}

	.hero-statement p {
		font-size: 0.9375rem;
		line-height: 1.5;
		margin-bottom: 0.25rem;
	}

	.hero-role {
		font-size: 0.8200rem;
		color: var(--text-secondary);
		margin-bottom: 0.1rem;
		margin-left: 0.5rem;
		text-align: left;
	}

	.hero-tech {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.skills-icon {
		width: 45px;
		height: 45px;
		object-fit: contain;
		display: block;
		opacity: 0.7;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.skills-icon:hover {
		opacity: 1;
		transform: translateY(-2px);
	}

	.skill-icon {
		width: 45px;
		height: 45px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.flask-icon {
		width: 45px;
		height: 45px;
		background: var(--text-primary);
		border-radius: 25%;
		padding: 4px;
	}

	.flask-icon img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	.full-stack-link {
		font-size: 0.75rem;
		color: var(--text-secondary);
		text-decoration: none;
		margin-bottom: 0.75rem;
		transition: color 0.2s ease;
	}

	.full-stack-link:hover {
		color: var(--text-primary);
	}

	.tech-icon {
		font-size: 0.8125rem;
		color: var(--text-tertiary);
		padding: 0.375rem 0.75rem;
		background: var(--bg-tertiary);
		border-radius: 4px;
	}

	.hero-social {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.social-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--text-tertiary);
		transition: color 0.2s ease;
	}

	.social-link:hover {
		color: var(--text-primary);
	}

	.social-icon {
		font-size: 1rem;
	}

	.social-detail {
		font-size: 0.75rem;
	}

	.scroll-down-link {
		font-size: 1rem;
		color: var(--text-secondary);
		text-decoration: none;
		margin-bottom: 0.75rem;
		transition: color 0.2s ease;
		-webkit-animation: sdl 2s infinite;
		animation: sdl 2s infinite;
	}

	@-webkit-keyframes sdl {
		0% {
			-webkit-transform: translate(0, 0);
		}
		20% {
			-webkit-transform: translate(0px, 10px);
		}
		40% {
			-webkit-transform: translate(0, 0);
		}
	}

	@keyframes sdl {
		0% {
			transform: translate(0, 0);
		}
		20% {
			transform: translate(0px, 10px);
		}
		40% {
			transform: translate(0, 0);
		}
	}

	

	/* Projects */
	.projects {
		padding: 1.5rem 0;
	}

	.projects-header {
		margin-bottom: 1rem;
	}

	.projects-header h2 {
		margin-bottom: 0;
	}

	.projects-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.project-item {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--border-subtle);
		align-items: center;
	}

	.project-item:last-child {
		border-bottom: none;
	}

	.project-featured {
		padding: 1rem 0;
		border-bottom: 2px solid var(--border-medium);
	}

	.project-featured h3 {
		font-size: 1.25rem;
		color: var(--text-primary);
	}

	.project-main h3 {
		font-size: 1rem;
		margin-bottom: 0.5rem;
	}

	.project-desc {
		font-size: 0.8125rem;
		color: var(--text-secondary);
		margin-bottom: 0.5rem;
	}

	.project-tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.tech-tag {
		font-size: 0.75rem;
		color: var(--text-tertiary);
		padding: 0.25rem 0.5rem;
		background: var(--bg-tertiary);
		border-radius: 0;
	}

	.project-links {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		align-items: flex-end;
	}

	.project-link {
		font-size: 0.875rem;
		color: var(--text-secondary);
		transition: color 0.2s ease;
	}

	.project-link:hover {
		color: var(--text-primary);
	}

	/* Experience */
	.experience {
		padding: 1.5rem 0;
	}

	.experience-header {
		margin-bottom: 1rem;
	}

	.experience-header h2 {
		margin-bottom: 0;
	}

	.experience-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.experience-item {
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--border-subtle);
	}

	.experience-item:last-child {
		border-bottom: none;
	}

	.experience-main h3 {
		font-size: 1rem;
		margin-bottom: 0.125rem;
	}

	.experience-role {
		font-size: 0.75rem;
		color: var(--text-tertiary);
		margin-bottom: 0.125rem;
	}

	.experience-date {
		font-size: 0.75rem;
		color: var(--text-tertiary);
		margin-bottom: 0.125rem;
	}

	.experience-desc {
		font-size: 0.875rem;
		color: var(--text-secondary);
		margin: 0;
	}

	/* Contact */
	.contact {
		padding: 1.5rem 0;
	}

	.contact-content {
		max-width: 600px;
		margin: 0 auto;
	}

	.contact-content h2 {
		margin-bottom: 0.75rem;
	}

	.contact-desc {
		font-size: 0.8125rem;
		color: var(--text-secondary);
		margin-bottom: 1rem;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.form-label {
		font-size: 0.75rem;
		color: var(--text-tertiary);
	}

	.form-input {
	padding: 0.375rem 0.625rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border-subtle);
		border-radius: 0;
		font-size: 0.8125rem;
		color: var(--text-primary);
		font-family: inherit;
		transition: border-color 0.2s ease;
	}

	.form-input:focus {
		outline: none;
		border-color: var(--border-medium);
	}

	.form-textarea {
		resize: vertical;
		min-height: 100px;
	}

	.form-submit {
		padding: 0.5rem 1rem;
		background: var(--text-primary);
		color: var(--bg-primary);
		border: none;
		border-radius: 0;
		font-size: 0.8125rem;
		font-weight: 500;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.form-submit:hover {
		background: var(--text-secondary);
	}

	.contact-email {
		font-size: 0.75rem;
		color: var(--text-tertiary);
		text-align: center;
	}

	/* Communities */
	.communities {
		padding: 1.5rem 0;
	}

	.communities-header {
		margin-bottom: 0.75rem;
	}

	.communities-header h2 {
		margin-bottom: 0;
	}

	.community-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.community-item {
		padding: 0.375rem 0;
		border-bottom: 1px solid var(--border-subtle);
	}

	.community-item:last-child {
		border-bottom: none;
	}

	.community-item h3 {
		font-size: 0.875rem;
		margin-bottom: 0.125rem;
		color: var(--text-secondary);
	}

	.community-item > p:first-of-type {
		font-size: 0.6875rem;
		color: var(--text-tertiary);
		margin-bottom: 0.125rem;
	}

	.community-desc {
		font-size: 0.75rem;
		color: var(--text-tertiary);
		margin: 0;
	}

	/* Footer */
	.footer {
		padding: 1rem 0 1.5rem;
		border-top: 1px solid var(--border-subtle);
	}

	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-personal {
		font-size: 0.75rem;
		color: var(--text-tertiary);
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.footer-links a {
		font-size: 0.75rem;
		color: var(--text-secondary);
	}

	.footer-links a:hover {
		color: var(--text-primary);
	}

	.footer-copy {
		font-size: 0.6875rem;
		color: var(--text-tertiary);
	}

	/* Responsive */
	@media (max-width: 768px) {
