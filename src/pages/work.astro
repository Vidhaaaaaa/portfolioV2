---
import Layout from '../layouts/Layout.astro';
---

<Layout title="things i've built">
	<div class="container">
		<header class="page-header">
			<h1>things i've built</h1>
			<p class="page-intro">some shipped. some are still being built. some were questionable decisions that taught me a lot.</p>
		</header>

		<!-- Contributions -->
		<section class="contributions">
			<h2>contributions</h2>
			<div class="github-graph">
				<img src="/images/github-graph.png" alt="GitHub contribution graph" />
			</div>
			<p class="contributions-caption">slowly filling this thing up.</p>
			<a href="https://github.com/vidha" target="_blank" rel="noopener" class="see-more">see my github →</a>
		</section>

		<!-- Full Project Archive -->
		<section class="project-archive">
			<h2>project archive</h2>
			
			<div class="project-detail">
				<h3>contexta</h3>
				<p class="project-tagline">a conceptual memory layer for codebases</p>
				<p class="project-description">contexta is a tool that gives codebases a layer of memory — carrying decisions, history, and context alongside the code itself. it helps teams understand why code was written, not just what it does.</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">in progress</span>
					<span class="meta-label">year:</span>
					<span class="meta-value">2026</span>
				</div>
				<div class="project-stack">
					<span class="stack-label">stack:</span>
					<span class="stack-value">python · fastapi · postgresql · react · ollama</span>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">view project →</a>
					<a href="https://github.com/vidha/contexta" target="_blank" rel="noopener" class="project-link">github →</a>
				</div>
			</div>

			<div class="project-detail">
				<h3>skippit</h3>
				<p class="project-tagline">async interviews for startups</p>
				<p class="project-description">an asynchronous interview platform that lets startups screen candidates efficiently. candidates record responses at their convenience, and teams review collaboratively.</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">shipped</span>
					<span class="meta-label">year:</span>
					<span class="meta-value">2025</span>
				</div>
				<div class="project-stack">
					<span class="stack-label">stack:</span>
					<span class="stack-value">python · flask · webrtc · postgresql · react</span>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">view project →</a>
					<a href="https://github.com/vidha/skippit" target="_blank" rel="noopener" class="project-link">github →</a>
				</div>
			</div>

			<div class="project-detail">
				<h3>ditto</h3>
				<p class="project-tagline">screenshots → useful information</p>
				<p class="project-description">an ai-powered tool that extracts structured information from screenshots. great for quickly pulling data from designs, documents, or any visual content.</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">shipped</span>
					<span class="meta-label">year:</span>
					<span class="meta-value">2025</span>
				</div>
				<div class="project-stack">
					<span class="stack-label">stack:</span>
					<span class="stack-value">python · fastapi · tesseract · openai · react</span>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">view project →</a>
					<a href="https://github.com/vidha/ditto" target="_blank" rel="noopener" class="project-link">github →</a>
				</div>
			</div>

			<div class="project-detail">
				<h3>snaptunnel</h3>
				<p class="project-tagline">peer-to-peer file sharing</p>
				<p class="project-description">a decentralized file sharing application using webtorrent. transfer files directly between devices without servers.</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">shipped</span>
					<span class="meta-label">year:</span>
					<span class="meta-value">2025</span>
				</div>
				<div class="project-stack">
					<span class="stack-label">stack:</span>
					<span class="stack-value">javascript · webtorrent · webRTC · react</span>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">view project →</a>
					<a href="https://github.com/vidha/snaptunnel" target="_blank" rel="noopener" class="project-link">github →</a>
				</div>
			</div>

			<div class="project-detail">
				<h3>ticketledger</h3>
				<p class="project-tagline">decentralized ticketing on aptos</p>
				<p class="project-description">a blockchain-based ticketing system built on aptos. prevents scalping and ensures transparent ticket ownership.</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">shipped</span>
					<span class="meta-label">year:</span>
					<span class="meta-value">2025</span>
				</div>
				<div class="project-stack">
					<span class="stack-label">stack:</span>
					<span class="stack-value">move · aptos · typescript · react</span>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">view project →</a>
					<a href="https://github.com/vidha/ticketledger" target="_blank" rel="noopener" class="project-link">github →</a>
				</div>
			</div>

			<div class="project-detail">
				<h3>blizzy</h3>
				<p class="project-tagline">[project description]</p>
				<p class="project-description">[detailed description of the project]</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">[status]</span>
					<span class="meta-label">year:</span>
					<span class="meta-value">[year]</span>
				</div>
				<div class="project-stack">
					<span class="stack-label">stack:</span>
					<span class="stack-value">[technologies]</span>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">view project →</a>
					<a href="https://github.com/vidha/blizzy" target="_blank" rel="noopener" class="project-link">github →</a>
				</div>
			</div>

			<div class="project-detail">
				<h3>logistics ml project</h3>
				<p class="project-tagline">[project description]</p>
				<p class="project-description">[detailed description of the project]</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">[status]</span>
					<span class="meta-label">year:</span>
					<span class="meta-value">[year]</span>
				</div>
				<div class="project-stack">
					<span class="stack-label">stack:</span>
					<span class="stack-value">python · pandas · scikit-learn · xgboost</span>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">view project →</a>
					<a href="https://github.com/vidha/logistics-ml" target="_blank" rel="noopener" class="project-link">github →</a>
				</div>
			</div>

			<div class="project-detail">
				<h3>sap project</h3>
				<p class="project-tagline">[project description]</p>
				<p class="project-description">[detailed description of the project]</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">[status]</span>
					<span class="meta-label">year:</span>
					<span class="meta-value">[year]</span>
				</div>
				<div class="project-stack">
					<span class="stack-label">stack:</span>
					<span class="stack-value">[technologies]</span>
				</div>
				<div class="project-links">
					<a href="#" class="project-link">view project →</a>
					<a href="https://github.com/vidha/sap-project" target="_blank" rel="noopener" class="project-link">github →</a>
				</div>
			</div>

			<div class="project-detail">
				<h3>other experiments</h3>
				<p class="project-tagline">random things i've built</p>
				<p class="project-description">a collection of smaller experiments, weekend projects, and things that seemed like a good idea at 2am.</p>
				<div class="project-meta">
					<span class="meta-label">status:</span>
					<span class="meta-value">various</span>
				</div>
				<div class="project-links">
					<a href="https://github.com/vidha" target="_blank" rel="noopener" class="project-link">see on github →</a>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.page-header {
		padding: 4rem 0 2rem;
	}

	.page-header h1 {
		margin-bottom: 1rem;
	}

	.page-intro {
		font-size: 1rem;
		color: var(--text-charcoal-light);
	}

	.contributions {
		padding: 2rem 0;
		border-bottom: 1px solid var(--border-subtle);
		margin-bottom: 2rem;
	}

	.github-graph {
		margin: 1.5rem 0;
		max-width: 100%;
	}

	.github-graph img {
		width: 100%;
		border-radius: 4px;
	}

	.contributions-caption {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.project-archive {
		padding: 2rem 0;
	}

	.project-detail {
		padding: 2rem 0;
		border-bottom: 1px solid var(--border-light);
	}

	.project-detail:last-child {
		border-bottom: none;
	}

	.project-detail h3 {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
	}

	.project-tagline {
		font-size: 0.9375rem;
		color: var(--accent-lavender);
		margin-bottom: 1rem;
	}

	.project-description {
		font-size: 0.9375rem;
		margin-bottom: 1rem;
		line-height: 1.7;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 0.75rem;
		font-size: 0.875rem;
	}

	.meta-label {
		color: var(--text-muted);
	}

	.meta-value {
		color: var(--text-charcoal-light);
	}

	.project-stack {
		margin-bottom: 1rem;
		font-size: 0.875rem;
	}

	.stack-label {
		color: var(--text-muted);
	}

	.stack-value {
		color: var(--text-charcoal-light);
	}

	.project-links {
		display: flex;
		gap: 1rem;
	}

	.project-link {
		font-size: 0.875rem;
		color: var(--accent-lavender);
	}

	.see-more {
		display: inline-block;
		margin-top: 1rem;
		font-size: 0.875rem;
		color: var(--accent-lavender);
	}

	@media (max-width: 768px) {
		.page-header {
			padding: 3rem 0 1.5rem;
		}

		.project-detail {
			padding: 1.5rem 0;
		}
	}
</style>