---
import Layout from '../layouts/Layout.astro';
---

<Layout title="hi again">
	<div class="container">
		<header class="page-header">
			<h1>hi again.</h1>
		</header>

		<article class="about-content">
			<!-- Personal story content - you'll write this yourself -->
			<section class="story-section">
				<h2>how i got into programming</h2>
				<p>[your story about how you started programming]</p>
			</section>

			<section class="story-section">
				<h2>why i like building things</h2>
				<p>[your thoughts on why you enjoy building]</p>
			</section>

			<section class="story-section">
				<h2>entrepreneurship & product building</h2>
				<p>[your journey into entrepreneurship and building products]</p>
			</section>

			<section class="story-section">
				<h2>contexta</h2>
				<p>[the story behind contexta and what it means to you]</p>
			</section>

			<section class="story-section">
				<h2>projects and experiments</h2>
				<p>[your approach to projects and what you've learned from experiments]</p>
			</section>

			<section class="story-section">
				<h2>eis</h2>
				<p>[your experience with the entrepreneur & innovation society]</p>
			</section>

			<section class="story-section">
				<h2>accelerate</h2>
				<p>[the story of starting the accelerate community]</p>
			</section>

			<section class="story-section">
				<h2>music & guitar</h2>
				<p>[your relationship with music and learning guitar]</p>
			</section>

			<section class="story-section">
				<h2>video editing</h2>
				<p>[your experience with video editing]</p>
			</section>

			<section class="story-section">
				<h2>books</h2>
				<p>[books that have influenced you and your reading habits]</p>
			</section>

			<section class="story-section">
				<h2>photos, friends & life</h2>
				<p>[thoughts on capturing moments and the people in your life]</p>
			</section>

			<section class="story-section">
				<h2>curiosity</h2>
				<p>[what drives your curiosity and exploration]</p>
			</section>

			<section class="story-section">
				<h2>what i'm figuring out</h2>
				<p>[what you're currently learning and figuring out]</p>
			</section>

			<p class="handwritten closing-note">life is kind of a sidequest.</p>
		</article>
	</div>
</Layout>

<style>
	.page-header {
		padding: 4rem 0 2rem;
	}

	.page-header h1 {
		margin-bottom: 1rem;
	}

	.about-content {
		padding: 2rem 0 4rem;
	}

	.story-section {
		margin-bottom: 3rem;
	}

	.story-section h2 {
		font-size: 1.25rem;
		margin-bottom: 1rem;
		color: var(--accent-lavender);
	}

	.story-section p {
		font-size: 1rem;
		line-height: 1.8;
		margin-bottom: 1rem;
	}

	.closing-note {
		margin-top: 3rem;
		font-size: 1.25rem;
		text-align: center;
	}

	@media (max-width: 768px) {
		.page-header {
			padding: 3rem 0 1.5rem;
		}

		.about-content {
			padding: 1.5rem 0 3rem;
		}

		.story-section {
			margin-bottom: 2rem;
		}

		.story-section h2 {
			font-size: 1.125rem;
		}

		.story-section p {
			font-size: 0.9375rem;
		}
	}
</style>