---
interface Props {
	title?: string;
}

const { title = "vidha" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Caveat:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-cream: #faf8f5;
		--bg-cream-dark: #f5f2ed;
		--text-charcoal: #2d2a26;
		--text-charcoal-light: #4a4743;
		--text-muted: #6b6762;
		--accent-lavender: #b8a9c4;
		--accent-lavender-light: #d4c8dc;
		--accent-yellow: #f5d76e;
		--accent-yellow-light: #fae8a8;
		--border-subtle: #e8e4df;
		--border-light: #f0ece7;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-size: 16px;
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		background-color: var(--bg-cream);
		color: var(--text-charcoal);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/* Typography - all lowercase */
	h1, h2, h3, h4, h5, h6 {
		font-weight: 500;
		color: var(--text-charcoal);
		line-height: 1.3;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 600;
	}

	h2 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
	}

	h3 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
	}

	p {
		color: var(--text-charcoal-light);
		margin-bottom: 1rem;
	}

	a {
		color: var(--text-charcoal);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--accent-lavender);
	}

	/* Handwritten font for personal notes */
	.handwritten {
		font-family: 'Caveat', cursive;
		font-size: 1.1rem;
		color: var(--text-muted);
	}

	/* Main content container - central column */
	.container {
		max-width: 680px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* Section spacing */
	section {
		padding: 4rem 0;
	}

	/* Subtle animations */
	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes subtleWiggle {
		0%, 100% {
			transform: rotate(-1deg);
		}
		50% {
			transform: rotate(1deg);
		}
	}

	@keyframes gentlePulse {
		0%, 100% {
			opacity: 1;
		}
		50% {
			opacity: 0.8;
		}
	}

	@keyframes slowFloat {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	.fade-in {
		animation: fadeIn 0.6s ease-out forwards;
	}

	/* Hover effects */
	.hover-lift {
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.hover-lift:hover {
		transform: translateY(-2px);
	}

	.hover-wiggle:hover {
		animation: subtleWiggle 0.3s ease-in-out;
	}

	.hover-fade {
		transition: opacity 0.2s ease;
	}

	.hover-fade:hover {
		opacity: 0.7;
	}

	/* Image hover effects */
	img {
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	img:hover {
		transform: scale(1.02);
	}

	/* Link hover underline effect */
	a {
		position: relative;
	}

	a::after {
		content: '';
		position: absolute;
		width: 0;
		height: 1px;
		bottom: -2px;
		left: 0;
		background-color: var(--accent-lavender);
		transition: width 0.2s ease;
	}

	a:hover::after {
		width: 100%;
	}

	/* Responsive */
	@media (max-width: 768px) {
		h1 {
			font-size: 2rem;
		}

		h2 {
			font-size: 1.5rem;
		}

		.container {
			padding: 0 1rem;
		}

		section {
			padding: 3rem 0;
		}
	}
</style>
