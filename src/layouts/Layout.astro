---
interface Props {
	title?: string;
}

const { title = "vidha" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<link
			rel="stylesheet"
			href="https://unpkg.com/github-contrib-graph@3.1.1/dist/gh.css"
		/>
	</head>

	<body>
		<!-- Animated dither background -->
		<canvas id="dither-bg" aria-hidden="true"></canvas>

		<!-- Site content -->
		<div class="site-content">
			<slot />
		</div>

		<!-- Cat cursor -->
		<img
			src="src/images/cursor1.png"
			class="cat-cursor"
			alt="cat cursor"
		/>

		<!-- Walking Cat by TechTools.cz -->
		<script
			src="https://techtools.cz/tools/walking-cat/cat.js"
			data-skin="white"
			data-scale="1"
			data-speed="normal"
			data-behavior="stroll"
			defer
		></script>
	</body>
</html>

<script>
	import { createDitheredWaves } from "ditherwave/vanilla";

	const canvas = document.getElementById("dither-bg");

	if (canvas instanceof HTMLCanvasElement) {
		const darkMode = window.matchMedia(
			"(prefers-color-scheme: dark)"
		);

		const getOptions = () => ({
			/* Very subtle waves in both themes */
			waveColor: darkMode.matches ? "#444444" : "#EEEEEE",

			/* Existing portfolio backgrounds */
			baseColor: darkMode.matches ? "#000000" : "#FFFFFF",

			
			waveFrequency: 2.5,
			waveAmplitude: 0.6,

			/* Small pixels */
			pixelSize: 1,

			/* Keep the palette restrained */
			colorNum: 4,
			matrixSize: 8,
		});

		createDitheredWaves(canvas, getOptions());

		/*
		 * Reinitialize when the OS/browser theme changes.
		 * This keeps the background synchronized with the existing
		 * prefers-color-scheme theme.
		 */
		darkMode.addEventListener("change", () => {
			createDitheredWaves(canvas, getOptions());
		});
	}
</script>

<style is:global>
	:root {
		/* Light mode - monochrome */
		--bg-primary: #ffffff;
		--bg-secondary: #fafafa;
		--bg-tertiary: #f5f5f5;

		--text-primary: #0a0a0a;
		--text-secondary: #6b6b6b;
		--text-tertiary: #9b9b9b;

		--border-subtle: #e5e5e5;
		--border-medium: #d5d5d5;

		--surface: #fafafa;
		--surface-elevated: #f5f5f5;

		--mono-font:
			"JetBrains Mono",
			"SF Mono",
			"Fira Code",
			monospace;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			/* Dark mode - monochrome */
			--bg-primary: #0a0a0a;
			--bg-secondary: #141414;
			--bg-tertiary: #1a1a1a;

			--text-primary: #fafafa;
			--text-secondary: #9b9b9b;
			--text-tertiary: #6b6b6b;

			--border-subtle: #2a2a2a;
			--border-medium: #3a3a3a;

			--surface: #141414;
			--surface-elevated: #1a1a1a;
		}
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-size: 16px;
		scroll-behavior: smooth;
	}

	body {
		position: relative;
		min-height: 100vh;

		font-family:
			"Inter",
			-apple-system,
			BlinkMacSystemFont,
			sans-serif;

		background-color: var(--bg-primary);
		color: var(--text-primary);

		line-height: 1.5;

		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/*
	 * Full-screen dither background.
	 *
	 * It is a normal positive z-index layer rather than a negative
	 * z-index layer, so it cannot disappear behind the body's
	 * background color.
	 */
	#dither-bg {
		position: fixed;
		inset: 0;

		width: 100vw;
		height: 100vh;

		display: block;

		z-index: 0;

		pointer-events: none;
	}

	/*
	 * Everything belonging to the actual portfolio sits above
	 * the animated background.
	 */
	.site-content {
		position: relative;
		z-index: 1;
	}

	/* Typography */

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-weight: 600;
		color: var(--text-primary);
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	h1 {
		font-size: 2.25rem;
		font-weight: 600;
		letter-spacing: -0.04em;
	}

	h2 {
		font-size: 1.5rem;
		margin-bottom: 0.75rem;
		letter-spacing: -0.02em;
	}

	h3 {
		font-size: 1.125rem;
		margin-bottom: 0.75rem;
		font-weight: 500;
	}

	p {
		color: var(--text-secondary);
		margin-bottom: 0.5rem;
		line-height: 1.5;
		font-size: 0.875rem;
	}

	a {
		color: var(--text-primary);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--text-primary);
	}

	/* Monospace for technical metadata */

	.mono {
		font-family: var(--mono-font);
		font-size: 0.85em;
		color: var(--text-tertiary);
	}

	.mono-accent {
		font-family: var(--mono-font);
		font-size: 0.85em;
		color: var(--text-primary);
	}

	/* Section-specific width containers */

	.container-narrow {
		max-width: 700px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.container-medium {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.container-wide {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.container-full {
		width: 100%;
		padding: 0 1.5rem;
	}

	/* Section spacing */

	section {
		padding: 3rem 0;
	}

	/* Subtle animations */

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(8px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes subtleWiggle {
		0%,
		100% {
			transform: rotate(-1deg);
		}

		50% {
			transform: rotate(1deg);
		}
	}

	@keyframes gentlePulse {
		0%,
		100% {
			opacity: 1;
		}

		50% {
			opacity: 0.8;
		}
	}

	@keyframes slowFloat {
		0%,
		100% {
			transform: translateY(0);
		}

		50% {
			transform: translateY(-4px);
		}
	}

	.fade-in {
		animation: fadeIn 0.6s ease-out forwards;
	}

	/* Hover effects */

	.hover-lift {
		transition: transform 0.2s ease;
	}

	.hover-lift:hover {
		transform: translateY(-1px);
	}

	.hover-wiggle:hover {
		animation: subtleWiggle 0.3s ease-in-out;
	}

	.hover-fade {
		transition: opacity 0.2s ease;
	}

	.hover-fade:hover {
		opacity: 0.7;
	}

	/* Image hover effects */

	img {
		transition: opacity 0.2s ease;
	}

	img:hover {
		opacity: 0.9;
	}

	/* Link hover underline effect */

	a {
		position: relative;
	}

	a::after {
		content: "";
		position: absolute;
		width: 0;
		height: 1px;
		bottom: -2px;
		left: 0;
		background-color: var(--text-primary);
		transition: width 0.2s ease;
	}

	a:hover::after {
		width: 100%;
	}

	/* Cat cursor */

	:root {
		--cursor-size: 16px;
	}

	@media (hover: hover) and (pointer: fine) {
		* {
			cursor: none !important;
		}

		.cat-cursor {
			position: fixed;
			width: calc(var(--cursor-size) * 2.5);
			height: calc(var(--cursor-size) * 2.5);
			pointer-events: none;
			z-index: 9999;
			transition: transform 0.1s ease-out;
			font-size: var(--cursor-size);
			line-height: 1;
		}

		.cat-cursor.hover {
			transform: scale(1.3);
		}
	}

	@media (hover: none) or (pointer: coarse) {
		.cat-cursor {
			display: none;
		}
	}
</style>

<script is:global>
	// Cat cursor
	const cursor = document.querySelector(".cat-cursor");

	if (cursor) {
		document.addEventListener("mousemove", (e) => {
			cursor.style.left = e.clientX + "px";
			cursor.style.top = e.clientY + "px";
		});

		// Hover state for interactive elements
		const interactiveElements = document.querySelectorAll(
			"a, button, input, textarea"
		);

		interactiveElements.forEach((el) => {
			el.addEventListener("mouseenter", () => {
				cursor.classList.add("hover");
			});

			el.addEventListener("mouseleave", () => {
				cursor.classList.remove("hover");
			});
		});
	}
</script>