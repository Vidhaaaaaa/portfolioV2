---
interface Props {
	title?: string;
}

const { title = "vidha" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://unpkg.com/github-contrib-graph@3.1.1/dist/gh.css" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Engineering console palette - near-black + warm off-white + electric blue */
		--bg-primary: #0a0a0a;
		--bg-secondary: #141414;
		--bg-tertiary: #1a1a1a;
		--text-primary: #f5f5f0;
		--text-secondary: #a0a0a0;
		--text-tertiary: #606060;
		--accent-blue: #3b82f6;
		--accent-blue-light: #60a5fa;
		--accent-blue-dark: #2563eb;
		--border-subtle: #2a2a2a;
		--border-medium: #3a3a3a;
		--surface: #141414;
		--surface-elevated: #1a1a1a;
		--mono-font: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
		--status-green: #22c55e;
		--status-yellow: #eab308;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-size: 16px;
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		background-color: var(--bg-primary);
		color: var(--text-primary);
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/* Typography - all lowercase */
	h1, h2, h3, h4, h5, h6 {
		font-weight: 600;
		color: var(--text-primary);
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 600;
	}

	h2 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
	}

	h3 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
	}

	p {
		color: var(--text-secondary);
		margin-bottom: 1rem;
	}

	a {
		color: var(--text-primary);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--accent-blue-light);
	}

	/* Monospace for technical metadata */
	.mono {
		font-family: var(--mono-font);
		font-size: 0.85em;
		color: var(--text-tertiary);
	}

	.mono-accent {
		font-family: var(--mono-font);
		font-size: 0.85em;
		color: var(--accent-blue-light);
	}

	/* Section-specific width containers */
	.container-narrow {
		max-width: 700px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.container-medium {
		max-width: 900px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.container-wide {
		max-width: 900px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.container-full {
		width: 100%;
		padding: 0 1.5rem;
	}

	/* Section spacing */
	section {
		padding: 5rem 0;
	}

	/* Subtle animations */
	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes subtleWiggle {
		0%, 100% {
			transform: rotate(-1deg);
		}
		50% {
			transform: rotate(1deg);
		}
	}

	@keyframes gentlePulse {
		0%, 100% {
			opacity: 1;
		}
		50% {
			opacity: 0.8;
		}
	}

	@keyframes slowFloat {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	.fade-in {
		animation: fadeIn 0.6s ease-out forwards;
	}

	/* Hover effects */
	.hover-lift {
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.hover-lift:hover {
		transform: translateY(-2px);
	}

	.hover-wiggle:hover {
		animation: subtleWiggle 0.3s ease-in-out;
	}

	.hover-fade {
		transition: opacity 0.2s ease;
	}

	.hover-fade:hover {
		opacity: 0.7;
	}

	/* Image hover effects */
	img {
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	img:hover {
		transform: scale(1.02);
	}

	/* Link hover underline effect */
	a {
		position: relative;
	}

	a::after {
		content: '';
		position: absolute;
		width: 0;
		height: 1px;
		bottom: -2px;
		left: 0;
		background-color: var(--accent-blue-light);
		transition: width 0.2s ease;
	}

	a:hover::after {
		width: 100%;
	}

	/* Responsive */
	@media (max-width: 768px) {
		h1 {
			font-size: 2rem;
		}

		h2 {
			font-size: 1.5rem;
		}

		.container {
			padding: 0 1rem;
		}

		section {
			padding: 3rem 0;
		}
	}
</style>
