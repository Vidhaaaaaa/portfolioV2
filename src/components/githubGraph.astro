---
interface Props {
  data: {
    totalContributions: number;
    weeks: {
      contributionDays: {
        date: string;
        contributionCount: number;
        color: string;
      }[];
    }[];
  };
}

const { data } = Astro.props;

function getLevel(count: number) {
  if (count === 0) return 0;
  if (count <= 2) return 1;
  if (count <= 5) return 2;
  if (count <= 9) return 3;
  return 4;
}

function formatDate(date: string) {
  return new Date(`${date}T00:00:00`).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<div class="github-activity">
  <div class="github-header">
    <div>
      <p class="github-total">
        {data.totalContributions.toLocaleString()} contributions
      </p>
    </div>
  </div>

  <div class="calendar-wrapper">
    <div class="weekday-labels" aria-hidden="true">
      <span></span>
      <span>Mon</span>
      <span></span>
      <span>Wed</span>
      <span></span>
      <span>Fri</span>
      <span></span>
    </div>

    <div class="calendar-container">
      <div class="month-labels" aria-hidden="true">
        {(() => {
          const months = [];
          let lastMonth = -1;
          
          data.weeks.forEach((week, index) => {
            const firstDay = week.contributionDays[0];
            const date = new Date(`${firstDay.date}T00:00:00`);
            const month = date.toLocaleDateString('en-US', { month: 'short' });
            const currentMonth = date.getMonth();
            
            if (currentMonth !== lastMonth) {
              const weekWidth = 15; // 12px square + 3px gap
              months.push(
                <span key={month} style={`position: absolute; left: ${index * weekWidth}px`}>{month}</span>
              );
              lastMonth = currentMonth;
            }
          });
          
          return months;
        })()}
      </div>
      <div class="calendar">
        {data.weeks.map((week) => (
          <div class="github-week">
            {week.contributionDays.map((day) => {
              const level = getLevel(day.contributionCount);

              return (
                <div
                  class={`github-day github-level-${level}`}
                  title={`${formatDate(day.date)} · ${day.contributionCount} contribution${day.contributionCount === 1 ? "" : "s"}`}
                  aria-label={`${formatDate(day.date)}: ${day.contributionCount} contributions`}
                ></div>
              );
            })}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="github-legend">
    <span>less</span>
    <span class="legend-day github-level-0"></span>
    <span class="legend-day github-level-1"></span>
    <span class="legend-day github-level-2"></span>
    <span class="legend-day github-level-3"></span>
    <span class="legend-day github-level-4"></span>
    <span>more</span>
  </div>
</div>

<style>
  .github-activity {
    width: 100%;
    max-width: 100%;
    margin-top: 0;
    margin-bottom: 2rem;
    opacity: 0.8;
  }

  .github-header {
    margin-bottom: 0.75rem;
  }

  .github-label {
    margin: 0;
    font-size: 0.625rem;
    color: var(--text-tertiary, #606060);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .github-total {
    margin: 0.25rem 0 0;
    font-size: 0.6875rem;
    color: var(--text-secondary, #a0a0a0);
  }

  .calendar-wrapper {
    display: flex;
    gap: 0.4rem;
    padding-bottom: 0.3rem;
  }

  .calendar-container {
    display: flex;
    flex-direction: column;
    flex: 1;
    position: relative;
  }

  .month-labels {
    display: flex;
    gap: 0;
    margin-bottom: 0.25rem;
    position: relative;
    height: 14px;
  }

  .month-labels span {
    font-size: 0.5625rem;
    line-height: 14px;
    color: var(--text-tertiary, #606060);
    position: absolute;
    white-space: nowrap;
  }

  .weekday-labels {
    flex: 0 0 30px;
    display: grid;
    grid-template-rows: repeat(7, 12px);
    gap: 3px;
    padding-top: 1.2rem;
  }

  .weekday-labels span {
    font-size: 0.5rem;
    line-height: 12px;
    color: var(--text-tertiary, #606060);
  }

  .calendar {
    display: flex;
    gap: 3px;
    width: 100%;
  }

  .github-week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .github-day {
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
    border-radius: 2px;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .github-day:hover {
    transform: scale(1.35);
    box-shadow: 0 0 0 2px var(--bg-primary, #0a0a0a);
    cursor: pointer;
  }

  .github-level-0 {
    background: #E5E5E5;
  }

  .github-level-1 {
    background: #D0D0D0;
  }

  .github-level-2 {
    background: #BBBBBB;
  }

  .github-level-3 {
    background: #A6A6A6;
  }

  .github-level-4 {
    background: var(--text-primary, #0A0A0A);
  }

  .github-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    margin-top: 0.5rem;
    font-size: 0.5625rem;
    color: var(--text-tertiary, #606060);
  }

  .legend-day {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  @media (prefers-color-scheme: dark) {
    .github-level-0 {
      background: #2A2A2A;
    }

    .github-level-1 {
      background: #3A3A3A;
    }

    .github-level-2 {
      background: #4A4A4A;
    }

    .github-level-3 {
      background: #5A5A5A;
    }

    .github-level-4 {
      background: var(--text-primary, #FAFAFA);
    }
  }

  @media (max-width: 600px) {
    .github-day {
      width: 10px;
      height: 10px;
      flex-basis: 10px;
    }

    .github-week {
      gap: 3px;
    }

    .calendar {
      gap: 3px;
    }

    .weekday-labels {
      grid-template-rows: repeat(7, 10px);
      gap: 3px;
    }
  }
</style>