---
interface Props {
  data: {
    totalContributions: number;
    weeks: {
      contributionDays: {
        date: string;
        contributionCount: number;
        color: string;
      }[];
    }[];
  };
}

const { data } = Astro.props;

function getLevel(count: number) {
  if (count === 0) return 0;
  if (count <= 2) return 1;
  if (count <= 5) return 2;
  if (count <= 9) return 3;
  return 4;
}

function formatDate(date: string) {
  return new Date(`${date}T00:00:00`).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

const weekCount = data.weeks.length;

const months: { label: string; index: number }[] = [];
let lastMonth = -1;

data.weeks.forEach((week, index) => {
  const firstDay = week.contributionDays[0];
  if (!firstDay) return;

  const date = new Date(`${firstDay.date}T00:00:00`);
  const month = date.getMonth();

  if (month !== lastMonth) {
    months.push({
      label: date.toLocaleDateString("en-US", { month: "short" }),
      index,
    });
    lastMonth = month;
  }
});
---

<div class="github-activity">
  <div class="github-header">
    <p class="github-total">
      {data.totalContributions.toLocaleString()} contributions
    </p>
  </div>

  <div class="calendar-wrapper">
    <div class="weekday-labels" aria-hidden="true">
      {["", "Mon", "", "Wed", "", "Fri", ""].map((day) => (
        <span>{day}</span>
      ))}
    </div>

    <div class="calendar-container">
      <div class="calendar-scroll">
        <div
          class="month-labels"
          aria-hidden="true"
          style={`--week-count: ${weekCount}`}
        >
          {months.map((month) => (
            <span style={`--week-index: ${month.index}`}>
              {month.label}
            </span>
          ))}
        </div>

        <div
          class="calendar"
          role="group"
          aria-label="GitHub contribution activity"
        >
          {data.weeks.map((week) => (
            <div class="github-week">
              {week.contributionDays.map((day) => {
                const level = getLevel(day.contributionCount);

                return (
                  <div
                    class={`github-day github-level-${level}`}
                    title={`${formatDate(day.date)} · ${day.contributionCount} contribution${day.contributionCount === 1 ? "" : "s"}`}
                    aria-label={`${formatDate(day.date)}: ${day.contributionCount} contributions`}
                  ></div>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="github-legend">
    <span>less</span>
    <span class="legend-day github-level-0"></span>
    <span class="legend-day github-level-1"></span>
    <span class="legend-day github-level-2"></span>
    <span class="legend-day github-level-3"></span>
    <span class="legend-day github-level-4"></span>
    <span>more</span>
  </div>
</div>

<style>
  .github-activity {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0 0 2rem;
    opacity: 0.8;
  }

  .github-header {
    margin-bottom: 0.75rem;
  }

  .github-total {
    margin: 0.25rem 0 0;
    font-size: 0.6875rem;
    color: var(--text-secondary, #a0a0a0);
  }

  .calendar-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    min-width: 0;
  }

  .weekday-labels {
    flex: 0 0 25px;
    display: grid;
    grid-template-rows: repeat(7, 12px);
    gap: 3px;
    padding-top: 18px;
  }

  .weekday-labels span {
    font-size: 0.5rem;
    line-height: 12px;
    color: var(--text-tertiary, #606060);
  }

  /* Only this element scrolls horizontally */
  .calendar-container {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--border-medium, #d5d5d5) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .calendar-scroll {
    width: max-content;
    min-width: 100%;
  }

  .month-labels {
    position: relative;
    width: 100%;
    height: 18px;
    margin-bottom: 2px;
  }

  .month-labels span {
    position: absolute;
    left: calc(var(--week-index) * 15px);
    top: 0;
    white-space: nowrap;
    font-size: 0.5625rem;
    line-height: 14px;
    color: var(--text-tertiary, #606060);
  }

  .calendar {
    display: flex;
    gap: 3px;
    width: max-content;
  }

  .github-week {
    display: flex;
    flex: 0 0 12px;
    flex-direction: column;
    gap: 3px;
    width: 12px;
  }

  .github-day {
    display: block;
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
    border-radius: 2px;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .github-day:hover {
    position: relative;
    z-index: 1;
    transform: scale(1.2);
    box-shadow: 0 0 0 1px var(--bg-primary, #0a0a0a);
    cursor: pointer;
  }

  .github-level-0 {
    background: #e5e5e5;
  }

  .github-level-1 {
    background: #d0d0d0;
  }

  .github-level-2 {
    background: #bbbbbb;
  }

  .github-level-3 {
    background: #a6a6a6;
  }

  .github-level-4 {
    background: var(--text-primary, #0a0a0a);
  }

  .github-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    margin-top: 0.5rem;
    font-size: 0.5625rem;
    color: var(--text-tertiary, #606060);
  }

  .legend-day {
    width: 10px;
    height: 10px;
    flex: 0 0 10px;
    border-radius: 2px;
  }

  @media (prefers-color-scheme: dark) {
    .github-level-0 {
      background: #2a2a2a;
    }

    .github-level-1 {
      background: #3a3a3a;
    }

    .github-level-2 {
      background: #4a4a4a;
    }

    .github-level-3 {
      background: #5a5a5a;
    }

    .github-level-4 {
      background: var(--text-primary, #fafafa);
    }
  }

  @media (max-width: 600px) {
    .calendar-wrapper {
      gap: 0;
      max-width: calc(100% - 2rem);
      overflow: hidden;
      margin: 0 1rem;
    }

    .calendar-container {
      flex: 1 1 auto;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: thin;
      scrollbar-color: var(--border-medium, #d5d5d5) transparent;
      -webkit-overflow-scrolling: touch;
    }

    .weekday-labels {
      display: none;
    }

    /* Make squares larger on mobile for better visibility */
    .github-week {
      flex-basis: 10px;
      width: 10px;
      gap: 2px;
    }

    .github-day {
      width: 10px;
      height: 10px;
      flex-basis: 10px;
      border-radius: 2px;
    }

    .month-labels {
      height: 15px;
    }

    .month-labels span {
      left: calc(var(--week-index) * 12px);
      font-size: 0.5rem;
      line-height: 12px;
    }

    .calendar {
      gap: 2px;
    }

    .github-legend {
      margin-top: 0.5rem;
      font-size: 0.5rem;
      justify-content: center;
    }

    .legend-day {
      width: 10px;
      height: 10px;
      flex-basis: 10px;
    }
  }
</style>